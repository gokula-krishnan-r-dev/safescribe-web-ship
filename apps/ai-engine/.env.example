# SafeScribe AI Engine — environment variables
# Copy to .env and fill in values

# App
DEBUG=false
HOST=0.0.0.0
PORT=8010
WORKERS=4

# OpenAI
# Main model: synthesis / documentation. Fast model: extraction + optional counselling polish.
# Confirm → counselling uses pathway/regimen compose (no LLM) for <200ms UX.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI Pipeline tuning
CHUNK_SIZE_CHARS=3500
CHUNK_OVERLAP_CHARS=300
PARALLEL_CHUNK_LIMIT=5
MAX_CHUNKS_PER_DOC=50

# Redis (for Celery background workers)
REDIS_URL=redis://localhost:6379/1

# Security — must match INTERNAL_SECRET in NestJS .env
INTERNAL_SECRET=change-me-internal-secret-32chars

# OCR (requires system tesseract-ocr to be installed)
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300

# Optional webhook for async job completion
NESTJS_CALLBACK_URL=http://localhost:3001/api/v1/ai-engine/callback
