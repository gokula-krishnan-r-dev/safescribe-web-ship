# SafeScribe environment configuration
# Copy to .env and update values. Never commit .env to version control.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Docker Postgres publishes POSTGRES_PORT (default 5432). If Homebrew or another
# local Postgres already owns 5432, set POSTGRES_PORT=5433 and match DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://safescript:safescript@localhost:5432/safescript?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (use openssl rand -base64 48 in production) ──────────────────────────
# Access tokens are short-lived. Refresh/session hard-stop at 7 days from login
# (rotation does not extend the window). Remember-me no longer grants 30 days.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Super Admin (seeded on first run only) ───────────────────────────────────
# Password must be quoted when it contains special characters like !
# Three platform accounts are seeded: full access, pharmacy-only, and clinical-only.
SUPER_ADMIN_EMAIL=admin@safescript.com
SUPER_ADMIN_PASSWORD="SuperAdmin123!"
SUPER_ADMIN_PHARMACY_EMAIL=pharmacy-admin@safescript.com
SUPER_ADMIN_CLINICAL_EMAIL=clinical-admin@safescript.com

# ── App URLs ─────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Canonical public origin used for Open Graph, sitemap, and robots (production: https://safescribe.ca)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Renew module UI. Staging.safescribe.ca is always on; safescribe.ca stays off.
NEXT_PUBLIC_SAFESCRIBE_RENEW_ENABLED=true
# Adapt module UI. Staging.safescribe.ca is always on; safescribe.ca stays off.
NEXT_PUBLIC_SAFESCRIBE_ADAPT_ENABLED=true

# ── Security ───────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# API rate limits (NestJS throttler). Clinical JWT routes skip these — see throttle.config.ts
THROTTLE_SHORT_TTL_MS=1000
THROTTLE_SHORT_LIMIT=25
THROTTLE_MEDIUM_TTL_MS=10000
THROTTLE_MEDIUM_LIMIT=150
THROTTLE_LONG_TTL_MS=60000
THROTTLE_LONG_LIMIT=500

# ── Mail (Resend in staging/production; Mailpit SMTP fallback in local) ─────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@safescript.com
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=support@pharmasafe.ca

# Resend transactional email (Contact Us + pharmacy network verification + login 2FA)
# Production/staging: RESEND_ENABLED=true, API key from https://resend.com/api-keys
# From address must be a verified domain in Resend (SPF/DKIM).
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL="Safescript <noreply@phix.now>"
RESEND_WEBHOOK_SECRET=
# Public web origin used in email links (falls back to WEB_URL)
EMAIL_APP_URL=http://localhost:3000

# Email magic-link second factor after password (Pharmacist Admin + Pharmacist). Super Admin skipped.
# Off by default so users can sign in with email + password. Set true to require the verify-email step.
LOGIN_EMAIL_2FA_ENABLED=false
LOGIN_EMAIL_2FA_TTL_MINUTES=15
# Demo / walkthrough accounts skip email 2FA after a valid password (password is still required).
# Built-in: pharmacist@demo-pharmacy.com, admin@demo-pharmacy.com, admin@safescript.com.
# Add extra emails as a comma-separated list, or set to none to disable the bypass.
DEMO_LOGIN_BYPASS_EMAILS=

# ── OpenAI (API + AI Engine) ─────────────────────────────────────────────────
# Defaults to GPT-5.6 Luna. Override or change live in Super Admin → AI System.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FAST_MODEL=gpt-5.6-luna

# ── Python AI Engine ─────────────────────────────────────────────────────────
# Leave AI_ENGINE_URL blank to use the built-in Node.js pipeline.
# Local default is :8010 (make ai-dev) — :8000 is often taken by other tools.
AI_ENGINE_URL=http://localhost:8010
# Short calls (classify, consult). Pathway extract/generate use LONG timeout.
AI_ENGINE_TIMEOUT_MS=300000
AI_ENGINE_LONG_TIMEOUT_MS=900000
INTERNAL_SECRET=change-me-internal-secret-32chars

# ── Drug search (Canadian CCDD via Infoway Terminology Server) ────────────────
# Request credentials: https://infocentral.infoway-inforoute.ca/en/advanced-users
DRUG_SEARCH_PROVIDER=ccdd
INFOWAY_CLIENT_ID=
INFOWAY_CLIENT_SECRET=

# Optional — raises OpenFDA drug-label rate limits (treatment safety panel)
OPENFDA_API_KEY=

# ── iFax (consultation document fax — Step 6 Documents) ─────────────────────
# API key from iFax dashboard Settings. Never commit real keys.
IFAX_API_KEY=
IFAX_BASE_URL=https://api.ifaxapp.com/v1
IFAX_CALLER_ID=
IFAX_WEBHOOK_SECRET=
# Global kill-switch — false skips outbound calls (FaxLog FAILED + SKIPPED:IFAX_DISABLED)
IFAX_ENABLED=true
# Low | Standard | HD
IFAX_FAX_QUALITY=HD

# ── File uploads / clinical photos ───────────────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=20

# GCP Cloud Storage (recommended for production). Leave GCS_BUCKET empty to use local disk.
# Run: ./scripts/setup-gcs-attachments.sh
GCS_PROJECT_ID=safescribe-488815
GCS_BUCKET=safescribe-consult-attachments
# Absolute path to the service-account JSON key (never commit this file)
GOOGLE_APPLICATION_CREDENTIALS=

# Patient Care Summary translation (Documents step). Server-side only — never browser keys.
# Reuses the same GCP project / service account as GCS + Speech when set.
# Enable the API: ./scripts/setup-google-translate.sh
GOOGLE_CLOUD_PROJECT=safescribe-488815
GOOGLE_TRANSLATE_LOCATION=global
GOOGLE_TRANSLATE_MODEL=general/nmt
# Optional glossary resource prefix (requires a regional location, not global)
GOOGLE_TRANSLATE_GLOSSARY_PREFIX=
TRANSLATION_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=604800
GOOGLE_TRANSLATE_TIMEOUT_MS=15000

# Add treatment Quick add ranking lookback (days)
QUICK_ADD_LOOKBACK_DAYS=180

# ── Speech-to-Text (Consultation Step 1 live dictation) ──────────────────────
# Providers: whisper (OpenAI) | google-medical (GCP Speech-to-Text medical model)
STT_DEFAULT_PROVIDER=whisper
STT_WHISPER_ENABLED=true
# OpenAI: whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
# Large v3 (Groq): whisper-large-v3 | whisper-large-v3-turbo — set STT_GROQ_API_KEY
STT_WHISPER_MODEL=whisper-1
STT_GROQ_API_KEY=
# GROQ_API_KEY=
# STT_GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_GOOGLE_ENABLED=true
STT_GOOGLE_MODEL=medical_dictation
STT_GOOGLE_LANGUAGE=en-US
# Translate mode (Step 1): Whisper speech→English. Uses whisper-1 or Groq Large v3.
# STT_WHISPER_TRANSLATE_WINDOW_MS=2400


# ── SafeScribe Mic (phone-as-microphone companion) ───────────────────────────
SAFESCRIBE_MIC_ENABLED=true
# Renew module API. Staging VM should be true; production can stay false until launch.
SAFESCRIBE_RENEW_ENABLED=true
# Adapt module API. Staging VM should be true; production stays false until launch.
SAFESCRIBE_ADAPT_ENABLED=false
SAFESCRIBE_MIC_PILOT_TENANT_IDS=
MIC_PAIRING_TTL_SECONDS=300
MIC_SESSION_MAX_SECONDS=5400
MIC_HEARTBEAT_INTERVAL_SECONDS=15
MIC_MAX_UPLOAD_BYTES=262144000
MIC_AUDIO_RETENTION_MODE=DELETE_AFTER_SUCCESS
MIC_AUDIO_DELETE_GRACE_SECONDS=3600
# Prefer local disk for Mic audio parts (recommended on single-node API hosts)
MIC_USE_LOCAL_STORAGE=true
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=whisper-1

# ── Phix credential sync (inbound events from Phix; never store the Phix DB URL here) ──
PHIX_SYNC_API_KEY=
PHIX_SYNC_HMAC_SECRET=
# One-shot importer only (do not leave on the API process):
# PHIX_READONLY_DATABASE_URL=
