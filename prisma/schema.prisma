  DRUG_DISEASE
  PREGNANCY
  LACTATION
  RENAL_EGFR_BAND
}

enum SafetyClinicalAction {
  HARD_STOP
  PHARMACIST_REVIEW
  MONITOR
  INFO_ONLY
  NONE
}

enum SafetyRenalBandSeverity {
  BLOCK
  CAUTION
  SAFE
}

enum SafetyLactationRisk {
  HIGH_RISK
  MODERATE_RISK
  LOW_RISK
  UNKNOWN
}

enum SafetyInteractionSeverity {
  MAJOR
  MODERATE
  MINOR
}

enum SafetyPregnancyCategory {
  CONTRAINDICATED
  CAUTION
  PREFERRED
  UNKNOWN
}

enum SafetyLabComparator {
  LT
  LTE
  GT
  GTE
  EQ
  BETWEEN
}

enum SafetyMissingLabAction {
  REQUIRE_REVIEW
  SKIP_RULE
}

enum SafetyRuleStatus {
  DRAFT
  APPROVED
  PUBLISHED
  SUPERSEDED
  RETIRED
}

enum SafetySelectorType {
  EXACT_INGREDIENT
  HAS_INGREDIENT
  MEMBER_OF_CLASS
  STRUCTURAL_RELATIONSHIP
  VALUE_SET
  INGREDIENT_SELECTOR
  PRODUCT_SELECTOR
}

enum SafetyClinicalSeverity {
  INFO
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum SafetyEvalStatus {
  COMPLETE_NO_FINDINGS
  COMPLETE_WITH_FINDINGS
  VERIFICATION_INCOMPLETE
  INPUT_INCOMPLETE
  SERVICE_UNAVAILABLE
}

enum SafetyMatchType {
  exact_ingredient
  combination_product_contains_exact_ingredient
  same_class
  side_chain_structural
}

model SafetyKnowledgeRule {
  id               String         @id @default(cuid())
  code             String         @unique
  ruleType         SafetyRuleType
  jurisdiction     String         @default("ALL")
  operationalState String         @default("active")
  ownerId          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  owner    User?               @relation("SafetyRuleOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  versions SafetyRuleVersion[]

  @@index([ruleType])
  @@index([operationalState])
}

model SafetyRuleVersion {
  id                     String                 @id @default(cuid())
  ruleId                 String
  versionNumber          Int
  /// Workbook rule_version string (e.g. 1.0-draft)
  ruleVersionLabel       String?
  status                 SafetyRuleStatus       @default(DRAFT)
  changeSummary          String?
  summary                String
  detail                 String                 @db.Text
  clinicalSeverity       SafetyClinicalSeverity
  recommendedAction      String
  overrideAllowed        Boolean                @default(true)
  overrideReasonRequired Boolean                @default(true)
  acknowledgementRequired Boolean               @default(false)
  deduplicationGroup     String?
  specificityRank        Int                    @default(0)
  ruleEffect             String?
  effectiveStartDate     DateTime?
  effectiveEndDate       DateTime?
  importBatchId          String?
  importRowId            String?
  matchType              SafetyMatchType?
  relationshipType       String?
  /// Domain-specific payload from workbook columns
  payload                Json?
  approvedById           String?
  approvedAt             DateTime?
  publishedAt            DateTime?
  createdAt              DateTime               @default(now())

  rule         SafetyKnowledgeRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  approvedBy   User?                 @relation("SafetyRuleApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  participants SafetyRuleParticipant[]
  evidence     SafetyRuleEvidence[]
  labDetail      SafetyLabRuleDetail?
  ddiDetail      SafetyDdiRuleDetail?
  drugDiseaseDetail SafetyDrugDiseaseRuleDetail?
  pregnancyDetail SafetyPregnancyRuleDetail?
  lactationDetail SafetyLactationRuleDetail?
  renalDetail     SafetyRenalRuleDetail?
  releaseItems SafetyReleaseItem[]
  importBatch  ClinicalImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importRow    ClinicalImportRow?    @relation(fields: [importRowId], references: [id], onDelete: SetNull)

  @@unique([ruleId, versionNumber])
  @@index([status])
  @@index([deduplicationGroup])
}

model SafetyRuleParticipant {
  id             String             @id @default(cuid())
  versionId      String
  participantKey String
  selectorType   SafetySelectorType
  conceptText    String
  conceptCode    String?
  selectorVersion String?
  terminologySystem String?
  resolvedConceptIds String[]       @default([])
  routeScope     String?
  doseFormScope  String?
  resolutionStatus String?

  version SafetyRuleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([conceptCode])
}

model SafetyRuleEvidence {
  id            String    @id @default(cuid())
  versionId     String?
  /// Workbook evidence_link_id (unique within a release when set)
  evidenceLinkId String?
  ruleCode      String?
  ruleVersion   String?
  clinicalDomain String?
  evidenceRole  String?
  sourceType    String?
  source        String
  sourceOrganization String?
  sourceJurisdiction String?
  sourceIdentifier String?
  sourceVersionOrDate String?
  sourceUrl     String?
  sourceLocator String?
  section       String?
  evidenceSummary String? @db.Text
  applicabilityToRule String? @db.Text
  limitationsOrUncertainty String? @db.Text
  evidenceQuality String?
  recommendationStrength String?
  supportsRuleOutcome String?
  sourceStatus  String?   @default("ACTIVE")
  recordStatus  SafetyRuleStatus @default(DRAFT)
  approvalStatus String?  @default("NOT_REVIEWED")
  clinicalReviewer String?
  clinicalReviewDate DateTime?
  nextReviewDue DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  accessDate    DateTime?
  relevanceNote String?
  importBatchId String?
  extractedBy   String?
  extractionDate DateTime?

  version     SafetyRuleVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  importBatch ClinicalImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([evidenceLinkId])
  @@index([ruleCode, ruleVersion])
  @@index([importBatchId])
}

model SafetyLabRuleDetail {
  id                 String                 @id @default(cuid())
  versionId          String                 @unique
  drugIngredient     String
  observationKey     String
  observationDisplay String?
  loincCode          String?
  comparator         SafetyLabComparator
  thresholdLow       Float?
  thresholdHigh      Float?
  expectedUnit       String?
  maxAgeDays         Int                    @default(365)
  missingLabAction   SafetyMissingLabAction @default(REQUIRE_REVIEW)

  version SafetyRuleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([observationKey])
  @@index([drugIngredient])
}

model SafetyDdiRuleDetail {
  id                  String                    @id @default(cuid())
  versionId           String                    @unique
  drugA               String
  drugB               String
  drugASelectorType   String?
  drugASelectorCode   String?
  drugASelectorVersion String?
  drugBSelectorType   String?
  drugBSelectorCode   String?
  drugBSelectorVersion String?
  pairMatchMode       String?
  exposureWindowCode  String?
  interactionMechanismCode String?
  clinicalEffectCode  String?
  applicabilityConditionCode String?
  monitoringCode      String?
  monitoringDetail    String?
  interactionSeverity SafetyInteractionSeverity
  actionRequired      SafetyClinicalAction      @default(PHARMACIST_REVIEW)

  version SafetyRuleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([drugA])
  @@index([drugB])
  @@index([drugASelectorCode])
  @@index([drugBSelectorCode])
}

model SafetyDrugDiseaseRuleDetail {
  id                              String               @id @default(cuid())
  versionId                       String               @unique
  drugSelectorType                String
  drugSelectorCode                String
  drugSelectorVersion             String?
  drugDisplayName                 String?
  drugRouteScopeCode              String?
  conditionCodeSystemUri          String?
  conditionConceptCode            String?
  conditionTerminologyVersion     String?
  conditionDisplayName            String?
  conditionMatchMode              String?
  conditionClinicalStatusRequired String?
  conditionTemporalityCode        String?
  conditionSeverityRequirement    String?
  conditionVerificationRequirement String?
  applicabilityConditionCode      String?
  clinicalRationaleCode           String?
  monitoringCode                  String?
  monitoringDetail                String?
  actionRequired                  SafetyClinicalAction @default(PHARMACIST_REVIEW)

  version SafetyRuleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([drugSelectorCode])
  @@index([conditionConceptCode])
}

model SafetyPregnancyRuleDetail {
  id                String                  @id @default(cuid())
  versionId         String                  @unique
  drugName          String
  pregnancyCategory SafetyPregnancyCategory
  trimester         String                  @default("all")
  clinicalNote      String?
  actionRequired    SafetyClinicalAction    @default(HARD_STOP)

  version SafetyRuleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([drugName])
}

model SafetyLactationRuleDetail {
  id             String               @id @default(cuid())
  versionId      String               @unique
  drugName       String
  lactationRisk  SafetyLactationRisk
  bandSeverity   SafetyRenalBandSeverity @default(BLOCK)
  clinicalNote   String?
  actionRequired SafetyClinicalAction @default(HARD_STOP)

  version SafetyRuleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([drugName])
}

model SafetyRenalRuleDetail {
  id             String                  @id @default(cuid())
  versionId      String                  @unique
  drugName       String
  egfrMin        Float
  egfrMax        Float
  bandSeverity   SafetyRenalBandSeverity
  clinicalNote   String?
  actionRequired SafetyClinicalAction    @default(PHARMACIST_REVIEW)

  version SafetyRuleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([drugName])
  @@index([egfrMin, egfrMax])
}

model SafetyKnowledgeRelease {
  id                    String   @id @default(cuid())
  version               String   @unique
  checksum              String
  engineVersion         String   @default("safety-engine-1.0.0")
  jurisdiction          String   @default("CA")
  terminologyReleaseId  String?
  releaseNotes          String?  @db.Text
  effectiveFrom         DateTime @default(now())
  publishedById         String
  priorReleaseId        String?
  publishedAt           DateTime @default(now())

  publishedBy          User                    @relation("SafetyReleasePublisher", fields: [publishedById], references: [id])
  priorRelease         SafetyKnowledgeRelease? @relation("SafetyReleaseHistory", fields: [priorReleaseId], references: [id], onDelete: SetNull)
  nextReleases         SafetyKnowledgeRelease[] @relation("SafetyReleaseHistory")
  items                SafetyReleaseItem[]
  pointer              SafetyReleasePointer?
  terminologyRelease   TerminologyRelease?     @relation(fields: [terminologyReleaseId], references: [id], onDelete: SetNull)
  valueSets            ClinicalValueSet[]
  testCases            ClinicalTestCase[]
  testInputs           ClinicalTestInput[]
  importBatches        ClinicalImportBatch[]

  @@index([publishedAt])
  @@index([terminologyReleaseId])
}

model SafetyReleaseItem {
  id        String @id @default(cuid())
  releaseId String
  versionId String

  release SafetyKnowledgeRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  version SafetyRuleVersion      @relation(fields: [versionId], references: [id])

  @@unique([releaseId, versionId])
}

model SafetyReleasePointer {
  id        String   @id @default("singleton")
  releaseId String   @unique
  updatedAt DateTime @updatedAt

  release SafetyKnowledgeRelease @relation(fields: [releaseId], references: [id])
}

model MedicationIngredient {
  id          String   @id @default(cuid())
  productName String   @unique
  genericName String?
  ingredients String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([genericName])
}

model DrugClassMembership {
  id        String @id @default(cuid())
  drugName  String
  className String

  @@unique([drugName, className])
  @@index([className])
  @@index([drugName])
}

/// Governed drug-class taxonomy (class hierarchy for safety matching).
model DrugClassTaxonomy {
  id               String   @id @default(cuid())
  className        String   @unique
  parentClass      String?
  therapeuticGroup String?
  riskTags         String[]
  externalId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([parentClass])
  @@index([therapeuticGroup])
}

/// Governed drug catalog — links drugs to classes, brands, and clinical notes.
model DrugCatalog {
  id           String   @id @default(cuid())
  drugName     String   @unique
  className    String
  ingredient   String?
  commonBrands String[]
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([className])
  @@index([ingredient])
}

model SafetyEvaluation {
  id                   String           @id @default(cuid())
  consultationId       String?
  tenantId             String?
  status               SafetyEvalStatus
  knowledgeRelease     String?
  engineVersion        String?
  terminologyReleaseId String?
  terminologyVersion   String?
  requestPayload       Json?
  createdAt            DateTime         @default(now())

  consultation       Consultation?             @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  findings           SafetyEvaluationFinding[]
  override           SafetyEvaluationOverride?
  terminologyRelease TerminologyRelease?       @relation(fields: [terminologyReleaseId], references: [id], onDelete: SetNull)

  @@index([consultationId])
  @@index([tenantId])
  @@index([createdAt])
  @@index([terminologyReleaseId])
}

model SafetyEvaluationFinding {
  id                String                 @id @default(cuid())
  evaluationId      String
  findingType       String
  matchType         String?
  summary           String
  detail            String                 @db.Text
  clinicalSeverity  SafetyClinicalSeverity
  recommendedAction String
  ruleVersionId     String?
  ruleCode          String?
  displayed         Boolean                @default(true)
  suppressedReason  String?

  evaluation SafetyEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

model SafetyEvaluationOverride {
  id            String   @id @default(cuid())
  evaluationId  String   @unique
  reasonCode    String
  reasonComment String?
  userId        String
  createdAt     DateTime @default(now())

  evaluation SafetyEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─── Clinical Repository (12-file import, value sets, tests, terminology) ───

enum ClinicalImportBatchStatus {
  UPLOADED
  PARSING
  VALIDATING
  REQUIRES_CORRECTION
  READY_TO_IMPORT
  IMPORTED
  FAILED
  CANCELLED
}

enum ClinicalImportRowStatus {
  PENDING
  VALID
  WARNING
  ERROR
  IMPORTED
  SKIPPED
}

enum TerminologyReleaseStatus {
  DISCOVERED
  DOWNLOADED
  STAGED
  VALIDATED
  READY
  ACTIVE
  FAILED
  RETIRED
}

enum ValueSetMembershipAction {
  INCLUDE
  EXCLUDE
}

model ClinicalImportBatch {
  id                String                    @id @default(cuid())
  fileTypeKey       String?
  originalFilename  String
  storagePath       String?
  sha256            String
  workbookSheetName String?
  headerFingerprint String?
  schemaVersion     String?
  status            ClinicalImportBatchStatus @default(UPLOADED)
  totalRows         Int                       @default(0)
  validRows         Int                       @default(0)
  warningRows       Int                       @default(0)
  errorRows         Int                       @default(0)
  targetReleaseId   String?
  jurisdiction      String                    @default("CA")
  terminologyReleaseId String?
  failureSummary    String?                   @db.Text
  uploadedAt        DateTime                  @default(now())
  uploadedById      String
  importedAt        DateTime?
  importedById      String?

  uploadedBy           User                     @relation("ClinicalImportUploader", fields: [uploadedById], references: [id])
  importedBy           User?                    @relation("ClinicalImportImporter", fields: [importedById], references: [id], onDelete: SetNull)
  targetRelease        SafetyKnowledgeRelease?  @relation(fields: [targetReleaseId], references: [id], onDelete: SetNull)
  terminologyRelease   TerminologyRelease?      @relation(fields: [terminologyReleaseId], references: [id], onDelete: SetNull)
  rows                 ClinicalImportRow[]
  ruleVersions         SafetyRuleVersion[]
  ruleEvidence         SafetyRuleEvidence[]
  valueSets            ClinicalValueSet[]
  valueSetMembers      ClinicalValueSetMember[]
  testCases            ClinicalTestCase[]
  testInputs           ClinicalTestInput[]
  renewInputDefinitions     RenewMonitoringInput[]
  renewMonitoringRules      RenewMonitoringRule[]
  renewConditionalQuestions RenewConditionalQuestion[]
  renewIndicationMaps       RenewMedicationIndicationMap[]

  @@unique([sha256, targetReleaseId])
  @@index([status])
  @@index([fileTypeKey])
  @@index([uploadedAt])
}

model ClinicalImportRow {
  id                 String                  @id @default(cuid())
  importBatchId      String
  sourceRowNumber    Int
  businessKey        String?
  rawPayload         Json
  normalizedPayload  Json?
  rowStatus          ClinicalImportRowStatus @default(PENDING)
  errors             Json                    @default("[]")
  warnings           Json                    @default("[]")
  promotedRecordType String?
  promotedRecordId   String?
  createdAt          DateTime                @default(now())

  importBatch  ClinicalImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  ruleVersions SafetyRuleVersion[]

  @@unique([importBatchId, sourceRowNumber])
  @@index([rowStatus])
  @@index([businessKey])
}

model ClinicalValueSet {
  id                         String           @id @default(cuid())
  releaseId                  String?
  valueSetCode               String
  valueSetVersion            String
  displayName                String
  description                String?          @db.Text
  clinicalDomain             String
  intendedUse                String
  memberConceptType          String
  terminologyBasis           String?
  candidateGenerationMethod  String?
  membershipMode             String
  routeScope                 String?
  doseFormScope              String?
  inclusionDefinition        String           @db.Text
  exclusionDefinition        String?          @db.Text
  clinicalSteward            String?
  reviewFrequencyMonths      Int?
  terminologyReleaseSnapshot String?
  recordStatus               SafetyRuleStatus @default(DRAFT)
  approvalStatus             String           @default("NOT_REVIEWED")
  effectiveFrom              DateTime?
  effectiveTo                DateTime?
  changeSummary              String?
  importBatchId              String?
  sourceRowId                String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  release     SafetyKnowledgeRelease?  @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  importBatch ClinicalImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  members     ClinicalValueSetMember[]

  @@unique([valueSetCode, valueSetVersion, releaseId])
  @@index([valueSetCode])
  @@index([recordStatus])
  @@index([importBatchId])
}

model ClinicalValueSetMember {
  id                      String                   @id @default(cuid())
  valueSetId              String
  memberSequence          Int
  membershipAction        ValueSetMembershipAction
  memberSelectorType      String
  memberLocalCode         String?
  memberDisplayName       String
  conceptDomain           String
  terminologySystem       String?
  terminologyConceptCode  String?
  terminologyDisplayName  String?
  terminologyVersion      String?
  routeScope              String?
  doseFormScope           String?
  candidateSource         String?
  candidateQueryReference String?
  mappingMethod           String?
  mappingConfidence       String?
  clinicalRationale       String?                  @db.Text
  clinicalReviewStatus    String
  reviewedBy              String?
  reviewedAt              DateTime?
  recordStatus            SafetyRuleStatus         @default(DRAFT)
  effectiveFrom           DateTime?
  effectiveTo             DateTime?
  changeSummary           String?
  importBatchId           String?
  sourceRowId             String?
  createdAt               DateTime                 @default(now())

  valueSet    ClinicalValueSet     @relation(fields: [valueSetId], references: [id], onDelete: Cascade)
  importBatch ClinicalImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([valueSetId, memberSequence])
  @@index([terminologyConceptCode])
  @@index([membershipAction])
  @@index([importBatchId])
}

model ClinicalTestCase {
  id                             String           @id @default(cuid())
  releaseId                      String?
  testCaseId                     String
  suiteVersion                   String
  testCaseName                   String
  safetyDomain                   String
  testType                       String
  priority                       String
  jurisdiction                   String
  scenarioSummary                String           @db.Text
  ruleCodeUnderTest              String?
  ruleVersionUnderTest           String?
  inputBundleKey                 String
  requiredRepositoryRelease      String?
  requiredTerminologyRelease     String?
  expectedRawMatchCount          Int
  expectedPrimaryRuleCode        String?
  expectedRuleEffect             String?
  expectedAlertSeverity          String?
  expectedActionCode             String?
  expectedDeduplicatedFindingCount Int
  expectedNoMatchReason          String?
  passCriteria                   String           @db.Text
  executionMode                  String
  contentStatus                  SafetyRuleStatus @default(DRAFT)
  testOwnerRole                  String?
  implementationNotes            String?          @db.Text
  importBatchId                  String?
  createdAt                      DateTime         @default(now())

  release     SafetyKnowledgeRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  importBatch ClinicalImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([testCaseId, suiteVersion, releaseId])
  @@index([inputBundleKey])
  @@index([safetyDomain])
  @@index([priority])
  @@index([importBatchId])
}

model ClinicalTestInput {
  id                   String           @id @default(cuid())
  releaseId            String?
  recordId             String
  inputBundleKey       String
  inputSequence        Int
  inputType            String
  entityRole           String
  payload              Json
  terminologyRelease   String?
  resolutionStatus     String
  contentStatus        SafetyRuleStatus @default(DRAFT)
  implementationNotes  String?          @db.Text
  importBatchId        String?
  createdAt            DateTime         @default(now())

  release     SafetyKnowledgeRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  importBatch ClinicalImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([recordId, releaseId])
  @@unique([inputBundleKey, inputSequence, releaseId])
  @@index([inputBundleKey])
  @@index([importBatchId])
}

model TerminologyRelease {
  id               String                   @id @default(cuid())
  releaseKey       String                   @unique
  status           TerminologyReleaseStatus @default(DISCOVERED)
  ccddVersion      String
  ccddCanonicalUrl String
  snomedVersion    String?
  dpdReleaseDate   DateTime?
  sourceMetadata   Json                     @default("{}")
  sourceChecksums  Json                     @default("{}")
  validationSummary Json                    @default("{}")
  downloadedAt     DateTime?
  validatedAt      DateTime?
  activatedAt      DateTime?
  createdAt        DateTime                 @default(now())
  createdById      String?

  createdBy          User?                     @relation("TerminologyReleaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  drugConcepts       TerminologyDrugConcept[]
  ingredientEdges    TerminologyIngredientEdge[]
  safetyReleases     SafetyKnowledgeRelease[]
  safetyEvaluations  SafetyEvaluation[]
  importBatches      ClinicalImportBatch[]

  @@index([status])
  @@index([ccddVersion])
}

model TerminologyDrugConcept {
  id                   String   @id @default(cuid())
  terminologyReleaseId String
  sourceSystem         String
  sourceCode           String
  sourceVersion        String
  conceptKey           String
  conceptType          String
  preferredNameEn      String
  preferredNameFr      String?
  normalizedSearchName String
  synonyms             Json     @default("[]")
  clinicalDrugCode     String?
  genericProductCode   String?
  packagedProductCode  String?
  snomedCode           String?
  brandName            String?
  strengthNumeratorValue Float?
  strengthNumeratorUnit String?
  strengthDenominatorValue Float?
  strengthDenominatorUnit String?
  doseFormCode         String?
  doseFormDisplay      String?
  routeCodes           String[] @default([])
  routeDisplays        String[] @default([])
  atcCodes             String[] @default([])
  dinCodes             String[] @default([])
  dpdDrugCodes         String[] @default([])
  marketStatus         String?
  manufacturerNames    String[] @default([])
  isActive             Boolean  @default(true)
  effectiveStart       DateTime?
  effectiveEnd         DateTime?
  replacedBySourceCode String?
  rawSource            Json
  createdAt            DateTime @default(now())

  terminologyRelease TerminologyRelease @relation(fields: [terminologyReleaseId], references: [id], onDelete: Cascade)
  asMedicationEdges  TerminologyIngredientEdge[] @relation("MedicationConcept")
  asIngredientEdges  TerminologyIngredientEdge[] @relation("IngredientConcept")

  @@unique([terminologyReleaseId, sourceSystem, sourceCode])
  @@index([normalizedSearchName])
  @@index([snomedCode])
  @@index([conceptType])
  @@index([isActive])
}

model TerminologyIngredientEdge {
  id                   String   @id @default(cuid())
  terminologyReleaseId String
  medicationId         String
  ingredientId         String
  relationshipType     String
  sourceRelationshipCode String?
  ingredientRole       String   @default("ACTIVE")
  basisOfStrength      Boolean?
  strengthNumeratorValue Float?
  strengthNumeratorUnit String?
  strengthDenominatorValue Float?
  strengthDenominatorUnit String?
  relationshipGroup    Int?
  provenanceSource     String
  provenanceVersion    String
  derivationMethod     String
  isActive             Boolean  @default(true)
  rawSource            Json
  createdAt            DateTime @default(now())

  terminologyRelease TerminologyRelease    @relation(fields: [terminologyReleaseId], references: [id], onDelete: Cascade)
  medication         TerminologyDrugConcept @relation("MedicationConcept", fields: [medicationId], references: [id], onDelete: Cascade)
  ingredient         TerminologyDrugConcept @relation("IngredientConcept", fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([terminologyReleaseId, medicationId, ingredientId, relationshipType, ingredientRole])
  @@index([terminologyReleaseId, medicationId])
  @@index([terminologyReleaseId, ingredientId])
}

// ─── Allergy Rule Engine ───────────────────────────────────────────────────────

enum AllergyDatasetStatus {
  ACTIVE
  ARCHIVED
  FAILED
}

model AllergyRuleDataset {
  id               String               @id @default(cuid())
  fileName         String
  storedName       String
  fileSize         Int
  mimeType         String
  status           AllergyDatasetStatus @default(ACTIVE)
  isActive         Boolean              @default(false)
  version          Int                  @default(1)
  drugCount        Int                  @default(0)
  classCount       Int                  @default(0)
  validationStatus String               @default("pending")
  parsingStatus    String               @default("pending")
  validationErrors Json?
  uploadedById     String
  uploadedAt       DateTime             @default(now())
  processedAt      DateTime?
  archivedAt       DateTime?

  uploadedBy User @relation("AllergyRuleUploadedBy", fields: [uploadedById], references: [id])

  @@index([isActive])
  @@index([uploadedAt])
  @@index([status])
}

/// Platform-wide editable AI system prompts (Super Admin). No tenantId.
model AiSystemPrompt {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  category       String
  content        String   @db.Text
  defaultContent String   @db.Text
  modelHint      String?
  sourceFile     String?
  sortOrder      Int      @default(0)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  updatedBy User? @relation("AiPromptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([sortOrder])
}

/// Singleton OpenAI / AI runtime settings (Super Admin). API key stays in env.
model AiPlatformSettings {
  id                   String   @id @default(cuid())
  openaiModel          String   @default("gpt-5.6-terra")
  openaiFastModel      String   @default("gpt-5.6-terra")
  openaiEmbeddingModel String   @default("text-embedding-3-small")
  temperatureDefault   Float    @default(0.1)
  maxRetries           Int      @default(3)
  timeoutSeconds       Int      @default(90)
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  updatedBy User? @relation("AiSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Platform-wide Doc Download Format templates (Super Admin).
/// Controls Doc module cards, AI prompts, response schema, and PDF download layout.
model DocumentFormatTemplate {
  id                   String   @id @default(cuid())
  key                  String   @unique
  name                 String
  shortName            String?
  description          String   @db.Text
  category             String
  categoryLabel        String
  bullets              Json
  fileName             String
  sortOrder            Int      @default(0)
  actions              Json
  aiPrompt             String   @db.Text
  styleNotes           String?  @db.Text
  exampleOutput        String   @db.Text
  /// Editable PDF section layout used on preview/download
  pdfLayout            Json?
  /// Expected AI JSON fields for this document
  responseSchema       Json?
  defaultName          String
  defaultShortName     String?
  defaultDescription   String   @db.Text
  defaultCategoryLabel String
  defaultBullets       Json
  defaultAiPrompt      String   @db.Text
  defaultStyleNotes    String?  @db.Text
  defaultExampleOutput String   @db.Text
  defaultPdfLayout     Json?
  defaultResponseSchema Json?
  published            Boolean  @default(true)
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  updatedBy User? @relation("DocFormatUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([sortOrder])
  @@index([published])
}

/// Super Admin QA workbook (48-pathway developer test pack or compatible Excel).
model PathwayQaWorkbook {
  id           String   @id @default(cuid())
  fileName     String
  sha256       String
  byteSize     Int
  sheetNames   String[] @default([])
  caseCount    Int      @default(0)
  conditionCount Int    @default(0)
  permutationCount Int  @default(0)
  parsed       Json
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User          @relation("PathwayQaWorkbookUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  runs       PathwayQaRun[]

  @@index([sha256])
  @@index([uploadedById, createdAt])
  @@index([createdAt])
}

/// One execution of a parsed workbook against a clinical pathway.
model PathwayQaRun {
  id                 String             @id @default(cuid())
  workbookId         String
  pathwayId          String
  status             PathwayQaRunStatus @default(RUNNING)
  matchedCondition   String?
  matchScore         Float?
  matchSuggestions   Json?
  summary            Json?
  results            Json?
  errorMessage       String?            @db.Text
  durationMs         Int?
  createdById        String
  startedAt          DateTime           @default(now())
  finishedAt         DateTime?
  createdAt          DateTime           @default(now())

  workbook  PathwayQaWorkbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  pathway   ClinicalPathway   @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  createdBy User              @relation("PathwayQaRunCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([pathwayId, createdAt])
  @@index([workbookId])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

/// Approved Renew condition library. Consultation-scoped mappings live in Consultation.renewPayload.
model RenewCondition {
  id                             String   @id @default(cuid())
  code                           String   @unique
  displayName                    String
  category                       String?
  description                    String?
  codeSystem                     String?
  externalCode                   String?
  defaultEffectivenessQuestion   String?
  commonForRenewal               Boolean  @default(true)
  displayPriority                Int      @default(100)
  active                         Boolean  @default(true)
  version                        Int      @default(1)
  effectiveDate                  DateTime?
  retiredDate                    DateTime?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  aliases        RenewConditionAlias[]
  indicationMaps RenewMedicationIndicationMap[]

  @@index([active, displayPriority])
  @@index([displayName])
}

model RenewConditionAlias {
  id               String  @id @default(cuid())
  conditionId      String
  alias            String
  normalizedAlias  String
  active           Boolean @default(true)

  condition RenewCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@unique([conditionId, normalizedAlias])
  @@index([normalizedAlias])
}

/// Curated medication ingredient → approved condition. medicationConceptId stores a normalized generic/brand key.
model RenewMedicationIndicationMap {
  id                         String   @id @default(cuid())
  medicationConceptId        String
  /// Spreadsheet ingredient_id (e.g. RAMIPRIL). Display/search key; matching uses medicationConceptId.
  ingredientId               String?
  drugName                   String?
  conditionId                String
  mappingStrength            String
  rankingWeight              Decimal? @db.Decimal(6, 2)
  suggestionRank             Int      @default(1)
  commonIndication           Boolean  @default(true)
  autoGroupAllowed           Boolean  @default(false)
  alwaysRequireConfirmation  Boolean  @default(false)
  active                     Boolean  @default(true)
  version                    Int      @default(1)
  ruleSetVersion             String   @default("live")
  sourceBatchId              String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  condition   RenewCondition       @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  sourceBatch ClinicalImportBatch? @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)

  @@unique([medicationConceptId, conditionId])
  @@index([medicationConceptId, active])
  @@index([ingredientId, active])
  @@index([sourceBatchId])
}

/// Governed CCDD medication concept ↔ SNOMED CT indication mapping (Approved Indications Repository).
model MedicationIndicationMapping {
  id                     String    @id @default(cuid())
  /// Canonical CCDD concept code (TM / ingredient / NTP / MP).
  medicationConceptId    String
  medicationDisplayName  String
  /// therapeutic_moiety | ingredient | ingredient_combination | clinical_drug | product
  medicationMappingLevel String    @default("ingredient")
  /// SNOMED CT concept id (numeric string).
  indicationConceptId    String
  indicationDisplayName  String
  /// approved_indication | guideline_supported | off_label | other
  relationshipType       String    @default("approved_indication")
  /// CA | AB | BC | ON | …
  jurisdiction           String    @default("CA")
  sourceReferenceId      String?
  sourceLabel            String?
  /// approved | retired
  status                 String    @default("approved")
  mappingVersion         Int       @default(1)
  notes                  String?   @db.VarChar(1000)
  validFrom              DateTime  @default(now())
  validTo                DateTime?
  createdById            String?
  updatedById            String?
  approvedById           String?
  retiredById            String?
  retiredAt              DateTime?
  /// Bridge to RenewCondition for Adapt/Renew resolver compatibility.
  legacyConditionId      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, jurisdiction])
  @@index([medicationConceptId, status])
  @@index([indicationConceptId, status])
  @@index([relationshipType, status])
  @@index([medicationMappingLevel, status])
  @@index([updatedAt])
  @@index([legacyConditionId])
  @@map("medication_indication_mappings")
}

/// Review-queue candidate for a medication–indication relationship (not production truth).
model MedicationIndicationCandidate {
  id                         String    @id @default(cuid())
  medicationConceptId        String
  medicationDisplayName      String?
  medicationMappingLevel     String    @default("ingredient")
  indicationConceptId        String
  indicationDisplayName      String
  /// pharmacist_selection | automated_extraction | import | admin_added
  sourceType                 String
  sourceReferenceId          String?
  jurisdiction               String    @default("CA")
  relationshipTypeSuggested  String?
  usageCount                 Int       @default(1)
  firstSeenAt                DateTime  @default(now())
  lastSeenAt                 DateTime  @default(now())
  /// pending | accepted | rejected | merged
  status                     String    @default("pending")
  reviewedById               String?
  reviewedAt                 DateTime?
  reviewNotes                String?
  promotedMappingId          String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@unique([medicationConceptId, medicationMappingLevel, indicationConceptId, jurisdiction])
  @@index([status, lastSeenAt])
  @@index([medicationConceptId, status])
  @@index([indicationConceptId, status])
  @@map("medication_indication_candidates")
}

/// Published Approved Indications repository release metadata.
model MedicationIndicationRepositoryVersion {
  id            String   @id @default(cuid())
  versionCode   String   @unique
  publishedAt   DateTime @default(now())
  publishedById String?
  changeSummary String?
  /// draft | published
  status        String   @default("published")
  mappingsAdded Int      @default(0)
  mappingsUpdated Int    @default(0)
  mappingsRetired Int    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([publishedAt])
  @@map("medication_indication_repository_versions")
}

/// Approved Renew monitoring input definitions. Consultation answers live in Consultation.renewPayload.
model RenewMonitoringInput {
  id                  String   @id @default(cuid())
  code                String   @unique
  label               String
  inputType           String
  valueShape          String
  unit                String?
  aliases             String[] @default([])
  displayPriority     Int      @default(100)
  /// Spreadsheet category: PATIENT_CONTEXT | VITAL | LAB | QUESTION
  category            String?
  /// Spreadsheet data_type: INTEGER | DECIMAL | TEXT | BOOLEAN | ENUM | DATE | COMPOSITE
  dataType            String?
  /// Approved renderer token: NUMBER_INPUT | TEXT_INPUT | SINGLE_SELECT | YES_NO | DATE_INPUT | LAB_INPUT | BP_INPUT
  uiComponent         String?
  allowDate           Boolean  @default(true)
  allowNotAvailable   Boolean  @default(true)
  /// Presentation-only conventional range. Never used as a safety threshold.
  normalRangeDisplay  String?
  active              Boolean  @default(true)
  version             Int      @default(1)
  ruleSetVersion      String   @default("live")
  sourceBatchId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  rules               RenewMonitoringRule[]
  sourceBatch         ClinicalImportBatch? @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)

  @@index([active, displayPriority])
  @@index([inputType, active])
  @@index([sourceBatchId])
}

/// Published medication/indication → monitoring or patient-context requirement.
model RenewMonitoringRule {
  id                    String   @id @default(cuid())
  /// Spreadsheet rule_id (e.g. RM001). Null on legacy starter rows.
  ruleCode              String?
  inputId               String
  matchType             String
  ingredientKey         String?
  conditionCode         String?
  /// CLASS | INGREDIENT
  appliesToType         String?
  /// Spreadsheet applies_to_id (ACE_INHIBITOR, METFORMIN)
  appliesToId           String?
  /// Spreadsheet indication_id (ANY, HTN, T2DM)
  indicationId          String?
  inputType             String?
  requirementLevel      String   @default("RECOMMENDED")
  freshnessDays         Int?
  actionIfMissing       String   @default("REVIEW")
  active                Boolean  @default(true)
  version               Int      @default(1)
  displayPriority       Int      @default(100)
  triggerSourceCode     String?
  triggerValue          String?
  ruleSetVersion        String   @default("live")
  sourceBatchId         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  input       RenewMonitoringInput @relation(fields: [inputId], references: [id], onDelete: Cascade)
  sourceBatch ClinicalImportBatch? @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)

  @@index([ingredientKey, active])
  @@index([conditionCode, active])
  @@index([inputId, active])
  @@index([ruleCode, ruleSetVersion])
  @@index([appliesToType, appliesToId, active])
  @@index([sourceBatchId])
}

/// Approved Renew-specific questions asked only when medication/indication makes them relevant.
model RenewConditionalQuestion {
  id               String   @id @default(cuid())
  questionRuleId   String
  appliesToType    String
  appliesToId      String
  indicationId     String
  questionCode     String
  questionText     String   @db.Text
  responseType     String
  triggerAnswer    String
  actionOnTrigger  String
  followupPrompt   String?  @db.Text
  active           Boolean  @default(true)
  ruleSetVersion   String   @default("live")
  sourceBatchId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceBatch ClinicalImportBatch? @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)

  @@unique([questionRuleId, ruleSetVersion])
  @@index([questionCode, active])
  @@index([appliesToType, appliesToId, active])
  @@index([sourceBatchId])
}

/// Pinned Renew workflow-configuration release (collection rules, not clinical safety thresholds).
model RenewConfigRelease {
  id            String    @id @default(cuid())
  releaseCode   String    @unique
  status        String
  notes         String?   @db.Text
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  publishedBy User? @relation("RenewConfigPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([status])
}

// ─── Clinical Safety — Reference & Target Values ───────────────────────────────

enum ClinicalReferenceRecordStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum ClinicalReferenceSourceStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

/// Immutable published snapshot of governed reference/target values.
model ClinicalReferenceRelease {
  id            String                        @id @default(cuid())
  releaseId     String                        @unique
  versionLabel  String
  status        ClinicalReferenceRecordStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?
  notes         String?                       @db.Text
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  values    ClinicalReferenceValue[]
  targets   ClinicalTreatmentTarget[]
  pediatric ClinicalPediatricReferencePolicy[]
  sources   ClinicalReferenceSource[]
  pointer   ClinicalReferencePointer?

  @@index([status])
}

model ClinicalReferencePointer {
  id        String @id @default("active")
  releaseId String @unique

  release ClinicalReferenceRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
}

model ClinicalReferenceSource {
  id              String                        @id @default(cuid())
  sourceCode      String
  versionNumber   Int                           @default(1)
  sourceName      String
  sourceType      String                        @default("OTHER")
  publisher       String?
  jurisdiction    String?
  version         String?
  publicationDate DateTime?
  effectiveDate   DateTime?
  sourceUrl       String?
  lastReviewedAt  DateTime?
  nextReviewDueAt DateTime?
  useCase         String?                       @db.Text
  notes            String?                       @db.Text
  status           ClinicalReferenceSourceStatus @default(DRAFT)
  reviewApprovedAt DateTime?
  releaseId        String?
  supersededById  String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  release      ClinicalReferenceRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  supersededBy ClinicalReferenceSource?  @relation("ClinicalReferenceSourceSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   ClinicalReferenceSource[] @relation("ClinicalReferenceSourceSupersede")

  @@unique([sourceCode, versionNumber])
  @@index([sourceCode, status])
  @@index([status])
  @@index([releaseId])
}

model ClinicalReferenceValue {
  id                String                        @id @default(cuid())
  referenceId       String
  versionNumber     Int                           @default(1)
  inputCode         String
  label             String
  category          String?
  population        String                        @default("ALL")
  sex               String                        @default("ALL")
  context           String?
  referenceStrategy String
  referenceKind     String
  uiUse             String?
  lowerNumeric      Float?
  upperNumeric      Float?
  operator          String?
  targetValue       String?
  unit              String?
  displayText       String?
  sourceCode        String?
  sourcePriority    Int?
  notes             String?                       @db.Text
  status            ClinicalReferenceRecordStatus @default(DRAFT)
  reviewApprovedAt  DateTime?
  effectiveDate     DateTime?
  releaseId         String?
  supersededById    String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  release      ClinicalReferenceRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  supersededBy ClinicalReferenceValue?   @relation("ClinicalReferenceValueSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   ClinicalReferenceValue[]  @relation("ClinicalReferenceValueSupersede")

  @@unique([referenceId, versionNumber])
  @@index([inputCode, status])
  @@index([status])
  @@index([sourceCode])
  @@index([releaseId])
}

model ClinicalTreatmentTarget {
  id              String                        @id @default(cuid())
  targetId        String
  versionNumber   Int                           @default(1)
  inputCode       String
  label           String
  population      String                        @default("ADULT")
  clinicalContext String
  parameter       String
  operator        String?
  targetValue     String?
  unit            String?
  displayText     String
  sourceCode      String
  targetType      String                        @default("TREATMENT_TARGET")
  notes              String?                       @db.Text
  status             ClinicalReferenceRecordStatus @default(DRAFT)
  reviewApprovedAt   DateTime?
  effectiveDate      DateTime?
  releaseId          String?
  supersededById     String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  release      ClinicalReferenceRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  supersededBy ClinicalTreatmentTarget?  @relation("ClinicalTreatmentTargetSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   ClinicalTreatmentTarget[] @relation("ClinicalTreatmentTargetSupersede")

  @@unique([targetId, versionNumber])
  @@index([inputCode, status])
  @@index([status])
  @@index([sourceCode])
  @@index([releaseId])
}

model ClinicalPediatricReferencePolicy {
  id                   String                        @id @default(cuid())
  inputCode            String
  versionNumber        Int                           @default(1)
  label                String?
  category             String?
  strategy             String
  preferredSource      String?
  fallbackAllowed      Boolean                       @default(false)
  adultFallbackAllowed Boolean                       @default(false)
  implementationNote   String?                       @db.Text
  sourceUrl            String?
  status               ClinicalReferenceRecordStatus @default(DRAFT)
  reviewApprovedAt     DateTime?
  releaseId            String?
  supersededById       String?
  createdById          String?
  updatedById          String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  release      ClinicalReferenceRelease?          @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  supersededBy ClinicalPediatricReferencePolicy?  @relation("ClinicalPediatricPolicySupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   ClinicalPediatricReferencePolicy[] @relation("ClinicalPediatricPolicySupersede")

  @@unique([inputCode, versionNumber])
  @@index([inputCode, status])
  @@index([status])
  @@index([releaseId])
}
