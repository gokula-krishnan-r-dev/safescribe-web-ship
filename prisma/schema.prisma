  @@index([population])
  @@index([category, isRetired, listStatus])
  @@index([matchStatus])
  @@index([productFormDisplay])
  @@index([routeDisplay])
  @@index([tenantId, isRetired])
  @@index([updatedAt])
  @@index([currentApprovedVersionId])
}

model TreatmentLibraryVersion {
  id            String                       @id @default(cuid())
  itemId        String
  versionNumber Int
  status        TreatmentLibraryVersionStatus
  payload       Json
  payloadHash   String
  changeSummary String?
  submittedById String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?                      @db.Text
  createdById   String
  updatedById   String
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  item       TreatmentLibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  treatments ClinicalTreatment[]

  @@unique([itemId, versionNumber])
  @@index([itemId, status])
  @@index([status])
  @@index([payloadHash])
}

model ClinicalCounselling {
  id             String    @id @default(cuid())
  pathwayId      String
