  pathwayId     String
  version       Int
  snapshot      Json
  publishedAt   DateTime
  publishedById String
  notes         String?
  createdAt     DateTime @default(now())

  pathway ClinicalPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([pathwayId, version])
  @@index([pathwayId])
}

model ClinicalPublication {
  id            String   @id @default(cuid())
  pathwayId     String
  version       Int
  publishedAt   DateTime @default(now())
  publishedById String
  isActive      Boolean  @default(true)
  notes         String?

  pathway ClinicalPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@index([pathwayId, isActive])
}

// ─── Consultation Enums ────────────────────────────────────────────────────────

enum ConsultationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConsultationStep {
  PRESENTING_COMPLAINT
  PATHWAY_SELECTION
  DEMOGRAPHICS
  CLINICAL_QUESTIONS
  RED_FLAGS
  ELIGIBILITY
  TREATMENT
  COUNSELLING
  DOCUMENTATION
  REVIEW
  /// Clinical Judgment — pharmacist working diagnosis
  CLINICAL_IMPRESSION
  /// Clinical Judgment — prescribing readiness gate
  PRESCRIBING_READINESS
  /// Clinical Judgment — post-safety treatment rationale
  TREATMENT_RATIONALE
  /// Renew module — Step 1 medications to renew
  RENEW_MEDICATIONS
  /// Renew module — therapy review
  RENEW_THERAPY_REVIEW
  /// Renew module — clinical assessment
  RENEW_CLINICAL_ASSESSMENT
  /// Renew module — renewal decision
  RENEW_DECISION
  /// Renew module — documentation
  RENEW_DOCUMENTATION
  /// Renew module — summary & send
  RENEW_SUMMARY
  /// Adapt module — Step 1 prescription & reason
  PRESCRIPTION_AND_REASON
  /// Adapt module — Step 2 patient assessment (also used as Adapt progress marker)
  PATIENT_ASSESSMENT
  /// Adapt module — Step 3 proposed adaptation + safety
  PROPOSED_ADAPTATION
  /// Adapt module — Step 4 documentation & complete
  DOCUMENTS_AND_COMPLETE
}

enum ConsultationMode {
  GUIDED_PATHWAY
  CLINICAL_JUDGMENT
  DOCUMENTATION_REFERRAL
}

enum DiagnosticCertainty {
  CONFIRMED
  PROBABLE
  UNCERTAIN
}

enum TreatmentSource {
  PATHWAY_RECOMMENDED
  PHARMACIST_SELECTED
}

enum RationaleStatus {
  DRAFT
  REVIEW_REQUIRED
  CONFIRMED
  STALE
  SUPERSEDED
}

enum AiContentSource {
  PHARMACIST
  AI_DRAFT
  AI_EDITED
  AI_ACCEPTED
  SYSTEM
}

enum CjWorkflowVersionStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum AlternativeCategory {
  WATCHFUL_WAITING
  OTC_MODIFICATION
  ALTERNATIVE_PRESCRIPTION
  NON_DRUG
  INVESTIGATION
  REFERRAL
  OTHER
}

enum AiArtifactType {
  ASSESSMENT_SUMMARY
  REASON_FOR_PRESCRIBING
  TREATMENT_RATIONALE
  ALTERNATIVE_SUGGESTIONS
  SAFETY_MITIGATION_SUMMARY
  DOCUMENT_DRAFT
}

// ─── Consultation ──────────────────────────────────────────────────────────────

model Consultation {
  id               String             @id @default(cuid())
  tenantId         String?
  pharmacistId     String
  consultationRef  String?            @unique
  status           ConsultationStatus @default(DRAFT)
  currentStep      ConsultationStep   @default(PRESENTING_COMPLAINT)
  stepIndex        Int                @default(0)
  /// prescribe | renew (and later adapt / cacp). Default keeps existing rows on Prescribe.
  module           String             @default("prescribe")

  /// GUIDED_PATHWAY | CLINICAL_JUDGMENT | DOCUMENTATION_REFERRAL (null = legacy guided)
  consultationMode ConsultationMode?
  /// When mode becomes DOCUMENTATION_REFERRAL, retain where the session started
  originMode       ConsultationMode?
  clinicalJudgmentWorkflowVersionId String?

  // Step 1 — Presenting Complaint
  transcript       String?            @db.Text
  /// Immutable Whisper raw output (SafeScribe Mic / batch STT). Editable draft stays in transcript.
  rawTranscript    String?            @db.Text
  transcriptSource TranscriptSource?
  chiefComplaint   String?
  /// Optional clinical photos / lesion images attached at intake (max 5). JSON array of AttachmentMeta.
  attachments      Json?

  // AI extracted data (JSON for flexibility)
  aiEntities       Json?              // extracted symptoms, meds, allergies etc
  aiAnalysis       Json?              // full AI analysis result

  // Step 2 — Pathway
  selectedPathwayId String?
  aiPathwaySuggestions Json?          // ranked pathway recommendations

  // Step 3 — Demographics
  demographics     Json?

  // Step 4 — Clinical Questions
  questionResponses Json?

  /// Guided-pathway Diagnosis Confirmation / Treatment Eligibility clinical judgement
  pathwayClinicalJudgement Json?

  // Step 5 — Red Flags
  redFlags         Json?

  /// Structured referral outcome when Safety screening ends in referral (not treatment).
  referralOutcome  ConsultationReferralOutcome?

  // Step 6 — Eligibility
  eligibility      Json?

  // Step 7 — Treatment
  treatmentPlan    Json?

  // Step 8 — Counselling
  counsellingNotes Json?

  // Step 9 — Documentation
  documentation    Json?

  /// Renew module payload (medication list, renewal request, later steps)
  renewPayload     Json?

  // Submission
  submittedAt      DateTime?
  lockedAt         DateTime?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant           Tenant?            @relation(fields: [tenantId], references: [id])
  pharmacist       User               @relation("ConsultationPharmacist", fields: [pharmacistId], references: [id])
  pathway          ClinicalPathway?   @relation(fields: [selectedPathwayId], references: [id])
  cjWorkflowVersion ClinicalJudgmentWorkflowVersion? @relation(fields: [clinicalJudgmentWorkflowVersionId], references: [id])
  clinicalJudgmentAssessment ClinicalJudgmentAssessment?
  treatmentRationale TreatmentRationale?
  clinicalRedFlagChecks ClinicalRedFlagCheck[]
  aiArtifacts      AiArtifact[]
  auditLogs        ConsultationAuditLog[]
  safetyEvaluations SafetyEvaluation[]
  faxLogs          FaxLog[]
  micPairings      MicPairing[]
  micSessions      MicSession[]
  micConsents      MicConsentRecord[]
  micAudioAssets   MicAudioAsset[]
  micTranscriptionJobs MicTranscriptionJob[]
  usageEvents      SafeScribeUsageEvent[]

  @@index([tenantId])
  @@index([pharmacistId])
  @@index([status])
  @@index([createdAt])
  @@index([consultationMode])
  @@index([tenantId, module, status])
  @@index([module, status])
}

/// Completed Add-treatment picks used to rank Quick add shortcuts.
/// Identity only — never stores dose, directions, or patient regimen data.
model TreatmentQuickAddUsage {
  id                    String   @id @default(cuid())
  tenantId              String?
  pharmacistId          String
  consultationId        String?
  pathwayId             String?
  medicationId          String
  clinicalDrugConceptId String
  displayName           String
  strengthLabel         String?
  dosageFormLabel       String?
  genericName           String?
  terminologySource     String   @default("ccdd")
  rxcui                 String?
  ndc                   String?
  createdAt             DateTime @default(now())

  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  pharmacist User    @relation(fields: [pharmacistId], references: [id], onDelete: Cascade)

  @@index([pharmacistId, createdAt])
  @@index([tenantId, pathwayId, createdAt])
  @@index([clinicalDrugConceptId])
  @@index([medicationId])
}

// ─── Clinical Judgment ─────────────────────────────────────────────────────────

model ClinicalJudgmentWorkflowVersion {
  id                   String                  @id @default(cuid())
  version              String                  @unique
  status               CjWorkflowVersionStatus @default(DRAFT)
  effectiveAt          DateTime?
  retiredAt            DateTime?
  /// Universal field requirements, UI copy, feature flags, prompt refs — no condition modules
  configuration        Json?
  promptBundleVersion  String?
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  consultations        Consultation[]
}

model ClinicalJudgmentAssessment {
  id                        String               @id @default(cuid())
  consultationId            String               @unique
  workingDiagnosisText      String               @db.VarChar(250)
  workingDiagnosisCode      String?
  workingDiagnosisSystem    String?
  diagnosticCertainty       DiagnosticCertainty?
  assessmentSummary         String?              @db.Text
  assessmentSummarySource   AiContentSource?
  assessmentSufficient      Boolean?
  unresolvedRedFlags        Boolean?
  readinessReason           String?              @db.Text
  /// Prescribing Readiness v1.0 decision status
  readinessStatus           String?
  /// JSON string[] of READINESS_INSUFFICIENCY_REASONS
  insufficiencyReasonCodes  Json?
  insufficiencyDetail       String?              @db.Text
  readinessNextAction       String?
  readinessReturnTarget     String?
  readinessSourceSnapshotHash String?
  redFlagCheckId            String?
  impressionConfirmedById   String?
  impressionConfirmedAt     DateTime?
  readinessConfirmedById    String?
  readinessConfirmedAt      DateTime?
  sourceSnapshotHash        String?
  rowVersion                Int                  @default(1)
  supersededAt              DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  consultation              Consultation         @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  redFlagChecks             ClinicalRedFlagCheck[]

  @@index([consultationId])
  @@index([readinessStatus])
}

/// Clinical Judgment AI Red-Flag Check (v1.0) — pharmacist-confirmed gate before readiness
model ClinicalRedFlagCheck {
  id                            String   @id @default(cuid())
  tenantId                      String?
  consultationId                String
  clinicalJudgmentAssessmentId  String
  patientProfileSnapshotId      String
  status                        String   // GENERATING | REVIEW_REQUIRED | MORE_INFORMATION_REQUIRED | CONFIRMED_CLEAR | REFERRAL_REQUIRED | STALE | SUPERSEDED | GENERATION_FAILED
  generationMode                String   // AI_GOVERNED_RETRIEVAL | MANUAL_FALLBACK
  sourceSnapshotHash            String
  evidenceCollectionVersion     String?
  deterministicRuleSetVersion   String   @default("cj-rules-v1")
  promptKey                     String?
  promptVersion                 String?
  model                         String?
  modelConfiguration            Json?
  inputManifest                 Json
  candidateManifest             Json?
  validationResult              Json?
  otherUnresolvedConcern        Boolean?
  otherConcernDetails           String?  @db.Text
  finalDecision                 String?  // READY_FOR_PRESCRIBING_READINESS | MORE_INFORMATION_REQUIRED | DOCUMENTATION_REFERRAL
  regenerationReason            String?
  regenerationReasonDetail      String?
  confirmedById                 String?
  confirmedAt                   DateTime?
  supersededById                String?
  rowVersion                    Int      @default(1)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  consultation                  Consultation              @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  assessment                    ClinicalJudgmentAssessment @relation(fields: [clinicalJudgmentAssessmentId], references: [id], onDelete: Cascade)
  questions                     ClinicalRedFlagQuestion[]
  manualConcerns                ClinicalRedFlagManualConcern[]

  @@index([consultationId, status])
  @@index([tenantId])
  @@index([sourceSnapshotHash])
}

model ClinicalRedFlagQuestion {
  id                  String   @id @default(cuid())
  redFlagCheckId      String
  sequence            Int
  candidateId         String
  canonicalLabel      String
  questionText        String   @db.Text
  whyItMatters        String   @db.Text
  severity            String   // CRITICAL | HIGH | MODERATE
  referralAction      String
  ruleId              String?
  sourceReferences    Json
  selectionReasonCode String
  answer              String?  // NO | YES | UNABLE_TO_CONFIRM
  answerNotes         String?  @db.Text
  answeredById        String?
  answeredAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  check               ClinicalRedFlagCheck @relation(fields: [redFlagCheckId], references: [id], onDelete: Cascade)

  @@unique([redFlagCheckId, sequence])
  @@unique([redFlagCheckId, candidateId])
  @@index([redFlagCheckId])
}

model ClinicalRedFlagManualConcern {
  id               String   @id @default(cuid())
  redFlagCheckId   String
  concernText      String   @db.Text
  whyItMatters     String?  @db.Text
  responseStatus   String   // RESOLVED | UNRESOLVED | MORE_INFORMATION_REQUIRED
  referralAction   String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  check            ClinicalRedFlagCheck @relation(fields: [redFlagCheckId], references: [id], onDelete: Cascade)

  @@index([redFlagCheckId])
}

model TreatmentRationale {
  id                        String            @id @default(cuid())
  consultationId            String            @unique
  status                    RationaleStatus   @default(DRAFT)
  reasonForPrescribing      String?           @db.Text
  reasonSource              AiContentSource?
  selectionRationale        String?           @db.Text
  rationaleSource           AiContentSource?
  safetyMitigationSummary   String?           @db.Text
  safetySummarySource       AiContentSource?
  reasonConfirmed           Boolean           @default(false)
  selectionConfirmed        Boolean           @default(false)
  alternativesConfirmed     Boolean           @default(false)
  safetyConfirmed           Boolean           @default(false)
  noAlternativesDocumented  Boolean           @default(false)
  inputSnapshotHash         String?
  safetyRunId               String?
  confirmedById             String?
  confirmedAt               DateTime?
  rowVersion                Int               @default(1)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  consultation              Consultation     @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  alternatives              TreatmentAlternative[]

  @@index([consultationId])
  @@index([status])
}

model TreatmentAlternative {
  id                  String              @id @default(cuid())
  rationaleId         String
  category            AlternativeCategory
  selected            Boolean             @default(false)
  details             String?             @db.Text
  notSelectedReason   String?
  suggestionSource    AiContentSource?
  selectedById        String?
  selectedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  rationale           TreatmentRationale  @relation(fields: [rationaleId], references: [id], onDelete: Cascade)

  @@index([rationaleId])
  @@unique([rationaleId, category])
}

model AiArtifact {
  id                  String          @id @default(cuid())
  consultationId      String
  artifactType        AiArtifactType
  promptKey           String?
  promptVersion       String?
  modelId             String?
  inputManifest       Json?
  inputSnapshotHash   String?
  rawOutput           String?         @db.Text
  validatedOutput     String?         @db.Text
  validationStatus    String?
  reviewStatus        String?
  disposition         String?
  latencyMs           Int?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  consultation        Consultation   @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([artifactType])
}

// ─── SafeScribe Mic ────────────────────────────────────────────────────────────

enum TranscriptSource {
  DESKTOP
  SAFESCRIBE_MIC
  MANUAL
}

enum MicPairingStatus {
  WAITING
  CLAIMED
  EXPIRED
  REVOKED
}

enum MicSessionState {
  WAITING
  CLAIMED
  CONSENT_REQUIRED
  READY
  RECORDING
  PAUSED
  FINALIZING
  TRANSCRIBING
  TRANSCRIPT_READY
  COMPLETED
  RECOVERABLE_ERROR
  FAILED
  EXPIRED
  CANCELLED
}

enum MicConsentStatus {
  GRANTED
  WITHDRAWN
}

enum MicSegmentStatus {
  OPEN
  UPLOADING
  COMPLETE
  INVALID
}

enum MicAudioAssetStatus {
  ASSEMBLING
  NORMALIZING
  READY
  DELETED
  FAILED
}

enum MicTranscriptionJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  RETRYABLE_ERROR
  FAILED
}

model MicPairing {
  id             String           @id @default(cuid())
  tenantId       String?
  consultationId String
  createdById    String
  tokenHash      String           @unique
  status         MicPairingStatus @default(WAITING)
  expiresAt      DateTime
  claimedAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  session      MicSession?

  @@index([consultationId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([tenantId])
}

model MicSession {
  id                 String          @id @default(cuid())
  tenantId           String?
  consultationId     String
  pairingId          String          @unique
  state              MicSessionState @default(WAITING)
  stateVersion       Int             @default(0)
  /// Ephemeral credential hash for phone (SHA-256). Never store raw token.
  credentialHash     String?         @unique
  credentialExpiresAt DateTime?
  clientMimeType     String?
  recordingStartedAt DateTime?
  recordingEndedAt   DateTime?
  lastHeartbeatAt    DateTime?
  lastPartReceivedAt DateTime?
  totalParts         Int             @default(0)
  totalBytes         BigInt          @default(0)
  failureCode        String?
  currentSegmentNumber Int           @default(0)
  /// Whisper ISO 639-1 code, or "auto" for detection
  sourceLanguage     String          @default("auto")
  /// When true, Whisper translates speech into English clinical notes
  translateToEnglish Boolean         @default(false)
  /// Language Whisper detected on the last successful transcript
  detectedLanguage   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  consultation Consultation         @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  pairing      MicPairing           @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  consents     MicConsentRecord[]
  segments     MicAudioSegment[]
  audioAssets  MicAudioAsset[]
  transcriptionJobs MicTranscriptionJob[]

  @@index([consultationId, createdAt(sort: Desc)])
  @@index([state, lastHeartbeatAt])
  @@index([tenantId])
}

model MicConsentRecord {
  id             String           @id @default(cuid())
  tenantId       String?
  consultationId String
  micSessionId   String
  consentType    String           @default("AUDIO_TRANSCRIPTION")
  status         MicConsentStatus @default(GRANTED)
  method         String           @default("VERBAL_PHARMACIST_ATTESTATION")
  noticeVersion  String
  attestedById   String
  attestedAt     DateTime         @default(now())
  withdrawnAt    DateTime?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  micSession    MicSession   @relation(fields: [micSessionId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([micSessionId])
}

model MicAudioSegment {
  id            String           @id @default(cuid())
  micSessionId   String
  segmentNumber Int
  startedAt     DateTime         @default(now())
  endedAt       DateTime?
  status        MicSegmentStatus @default(OPEN)

  micSession MicSession     @relation(fields: [micSessionId], references: [id], onDelete: Cascade)
  parts     MicAudioPart[]

  @@unique([micSessionId, segmentNumber])
  @@index([micSessionId])
}

model MicAudioPart {
  id             String   @id @default(cuid())
  micSessionId    String
  segmentId      String
  sequenceNumber Int
  storagePath    String
  contentType    String
  byteSize       Int
  checksumSha256 String?
  receivedAt     DateTime @default(now())

  segment MicAudioSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([segmentId, sequenceNumber])
  @@index([micSessionId])
}

model MicAudioAsset {
  id                    String              @id @default(cuid())
  tenantId              String?
  consultationId        String
  micSessionId           String
  source                String              @default("SAFESCRIBE_MIC")
  status                MicAudioAssetStatus @default(ASSEMBLING)
  originalContentType   String?
  normalizedContentType String?
  storagePath           String?
  byteSize              Int?
  durationSeconds       Float?
  checksumSha256        String?
  retentionMode         String              @default("DELETE_AFTER_SUCCESS")
  deleteAfter           DateTime?
  deletedAt             DateTime?
  failureCode           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  micSession    MicSession   @relation(fields: [micSessionId], references: [id], onDelete: Cascade)
  transcriptionJobs MicTranscriptionJob[]

  @@index([consultationId])
  @@index([micSessionId])
  @@index([status, deleteAfter])
}

model MicTranscriptionJob {
  id                String                    @id @default(cuid())
  tenantId          String?
  consultationId    String
  audioAssetId      String
  micSessionId       String
  provider          String                    @default("OPENAI")
  model             String                    @default("whisper-1")
  status            MicTranscriptionJobStatus @default(QUEUED)
  attemptCount      Int                       @default(0)
  idempotencyKey    String                    @unique
  responseFormat    String                    @default("verbose_json")
  languageHint      String?
  errorCode         String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  audioAsset   MicAudioAsset @relation(fields: [audioAssetId], references: [id], onDelete: Cascade)
  micSession    MicSession    @relation(fields: [micSessionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([consultationId])
}

enum FaxStatus {
  QUEUED
  SENDING
  DELIVERED
  FAILED
  CANCELED
}

/// Outbound fax jobs via iFax (consultation documents). No cover page is sent.
model FaxLog {
  id               String    @id @default(cuid())
  tenantId         String?
  consultationId   String
  userId           String
  documentTypeId   String
  documentName     String
  recipientName    String
  faxNumber        String
  status           FaxStatus @default(QUEUED)
  ifaxJobId        String?
  errorMessage     String?
  /// PDF byte size for audit (file itself is not retained)
  pdfBytes         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deliveredAt      DateTime?

  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([consultationId, createdAt])
  @@index([ifaxJobId])
  @@index([status])
}

/// Pharmacy-scoped fax directory for Send Fax autofill (docs Step 6).
/// Multiple recipient names may share the same fax number.
model PharmacyFaxContact {
  id           String   @id @default(cuid())
  tenantId     String
  /// Display name (e.g. "Dr. Smith" or "Walk-in Clinic")
  name         String
  /// Normalized E.164 when possible (e.g. +14165551234)
  faxNumber    String
  /// Optional admin note
  notes        String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, displayOrder])
  @@index([tenantId, faxNumber])
  @@index([tenantId, name])
}

model ConsultationAuditLog {
  id             String       @id @default(cuid())
  consultationId String
  userId         String
  action         String
  step           String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([createdAt])
}

enum ReferralOutcomeRecordStatus {
  DRAFT
  COMPLETED
}

enum ReferralLetterRecordStatus {
  NOT_CREATED
  DRAFT
  APPROVED
  STALE
  FINALIZED
  VOID
}

/// Structured referral completion from Safety screening (rules-triggered).
model ConsultationReferralOutcome {
  id                           String                      @id @default(cuid())
  consultationId               String                      @unique
  pathwayId                    String
  pathwayVersion               Int
  urgencyCode                  String
  urgencyDisplaySnapshot       String
  triggerSnapshot              Json
  destination                  String
  destinationOtherText         String?
  actionTaken                  String
  patientResponse              String
  additionalNote               String?                     @db.Text
  reasonForReferral            String?                     @db.Text
  providerId                   String?
  providerFacilitySnapshot     String?
  contactMethod                String?
  contactMethodOtherText       String?
  confirmationReceived         Boolean?
  handoffAt                    DateTime?
  status                       ReferralOutcomeRecordStatus @default(DRAFT)
  derivedOutcomeCode           String?
  documentationText            String?                     @db.Text
  referralLetterDraft          String?                     @db.Text
  /// Monotonic revision of letter-source facts (destination, action, triggers, etc.)
  sourceRevision               Int                         @default(1)
  sourceFingerprint            String?
  letterStatus                 ReferralLetterRecordStatus  @default(NOT_CREATED)
  letterApprovedAt             DateTime?
  letterApprovedById           String?
  letterApprovedSourceRevision Int?
  letterClientRequestId        String?
  /// Explicit pharmacist confirmation that referral was sent outside SafeScribe
  letterExternalSendConfirmed  Boolean?
  clientRequestId              String?
  completedById                String?
  completedAt                  DateTime?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  consultation Consultation                       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  letterVersions ConsultationReferralLetterVersion[]

  @@index([pathwayId])
  @@index([status])
  @@index([letterStatus])
  @@index([clientRequestId])
  @@index([letterClientRequestId])
  @@index([createdAt])
}

model ConsultationReferralLetterVersion {
  id              String   @id @default(cuid())
  letterOutcomeId String
  versionNumber   Int
  sourceRevision  Int
  status          String
  content         String   @db.Text
  renderedText    String?  @db.Text
  contentHash     String?
  factsSnapshot   Json?
  clientRequestId String?
  createdById     String?
  createdAt       DateTime @default(now())

  outcome ConsultationReferralOutcome @relation(fields: [letterOutcomeId], references: [id], onDelete: Cascade)

  @@unique([letterOutcomeId, versionNumber])
  @@index([letterOutcomeId])
  @@index([clientRequestId])
  @@index([createdAt])
}

