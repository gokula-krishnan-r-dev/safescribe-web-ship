generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Platform function for SUPER_ADMIN accounts. Tenant users leave this null.
enum SuperAdminScope {
  FULL
  PHARMACY
  CLINICAL
}

// ─── Clinical Pathway Enums ────────────────────────────────────────────────────

enum PathwayStatus {
  DRAFT
  AI_PROCESSING
  AI_GENERATED
  UNPUBLISHED
  PUBLISHED
  ARCHIVED
}

/// Staged clinical pathway generation pipeline (authoring workflow).
/// Status still controls publish lifecycle; pipelineStage tracks authoring progress.
enum PathwayPipelineStage {
  IDLE
  CLASSIFYING
  DOCUMENT_REVIEW
  EXTRACTING_CONCEPTS
  CONCEPTS_READY
  GENERATING
  CLINICAL_REVIEW
  COMPLETE
}

/// Admin/AI role for a source document during pathway authoring.
enum DocumentRole {
  PRIMARY
  SUPPORTING
  REFERENCE_ONLY
}

/// AI-classified clinical document type.
enum ClinicalDocumentType {
  CLINICAL_GUIDELINE
  NATIONAL_GUIDELINE
  PROVINCIAL_GUIDELINE
  CLINICAL_ALGORITHM
  ASSESSMENT_FORM
  DRUG_MONOGRAPH
  REVIEW_ARTICLE
  PATIENT_HANDOUT
  LOCAL_POLICY
  EDUCATIONAL_MATERIAL
  RESEARCH_ARTICLE
  OTHER
}

/// Normalized clinical concept categories (pre-pathway generation).
enum ClinicalConceptCategory {
  DIAGNOSIS
  HISTORY
  SYMPTOM
  RED_FLAG
  DIFFERENTIAL
  TREATMENT
  ELIGIBILITY
  COUNSELLING
  FOLLOW_UP
  LAB
  PHYSICAL_EXAM
  OTHER
}

enum QuestionType {
  TEXT
  TEXTAREA
  YES_NO
  DATE
  NUMBER
  SELECT
  MULTI_SELECT
  SCALE
}

enum QuestionStatus {
  AI_GENERATED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum RuleSeverity {
  INFO
  WARNING
  CRITICAL
  STOP
}

enum RuleAction {
  URGENT_REFERRAL
  STOP_PRESCRIBING
  SHOW_WARNING
  REQUIRE_DOCUMENTATION
  ADJUST_DOSE
  CONTRAINDICATED
}

enum ContentCreatedBy {
  AI
  USER
}

/// Never / Optional / Required — used for physical exam & lab requirements
enum RequirementLevel {
  NEVER
  OPTIONAL
  REQUIRED
}

/// Treatment Options taxonomy — consistent across every clinical pathway
enum TreatmentCategory {
  PRESCRIPTION
  OTC
  SUPPLEMENT
  NON_DRUG
}

/// Pharmacist-facing recommendation priority for a treatment option
enum RecommendationLevel {
  FIRST_LINE
  SECOND_LINE
  ALTERNATIVE
  ADJUNCTIVE
  SUPPORTIVE_CARE
  SPECIALIST
}

enum TreatmentLibraryVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  RETIRED
}

enum TreatmentLibraryMatchStatus {
  MATCHED
  INCOMPLETE
  UNMATCHED
}

enum TreatmentLibraryPopulation {
  ADULT
  PEDIATRIC
  WEIGHT_BASED
  OTHER
}

enum TreatmentLibraryLinkStatus {
  LINKED
  DETACHED
  MANUAL
}

enum PathwayQaRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum IpAccessMode {
  GLOBAL
  PER_USER
}

enum PharmacyNetworkStatus {
  PENDING
  APPROVED
  DISABLED
}

enum PharmacyNetworkSource {
  MANUAL
  VERIFICATION_LINK
  ALBERTA_LAUNCH
}

enum PharmacyNetworkVerificationStatus {
  SENT
  OPENED
  CONFIRMED
  APPROVED
  EXPIRED
  CANCELLED
  REJECTED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  /// Pharmacy outbound fax number shown on PCP letters and documents.
  faxNumber String?
  /// Optional pharmacy phone (patient handout / letter contact).
  phone     String?
  /// Street address shown on the Patient Care Summary Questions? section.
  address   String?
  /// IANA timezone used for daily/monthly usage reset (not UTC midnight).
  timezone  String       @default("America/Edmonton")
  /// Phix pharmacy id when this tenant was provisioned from Phix.
  phixPharmacyId String? @unique
  /// Licensed pharmacy number copied from Phix (display / matching only).
  pharmacyLicenseNumber String?
  /// True when this pharmacy is a Phix customer (same-credential login).
  phixCustomer Boolean @default(false)
  /// When false, pharmacists may sign in from any network. Allowed IPs are kept.
  networkAccessEnabled Boolean @default(true)
  /// Pharmacy logo / profile image shown on prescription PDFs.
  logoStorageKey      String?
  logoStorageProvider String?
  logoMimeType        String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users            User[]
  auditLogs        AuditLog[]
  clinicalPathways ClinicalPathway[]
  consultations    Consultation[]
  faxLogs          FaxLog[]
  faxContacts      PharmacyFaxContact[]
  ipAccess         TenantIpAccess?
  ipAllowlist      IpAllowlistEntry[]
  pharmacyNetworks PharmacyNetwork[]
  networkVerifications PharmacyNetworkVerification[]
  entitlements     SafeScribeEntitlement[]
  usageEvents      SafeScribeUsageEvent[]
  treatmentQuickAddUsages TreatmentQuickAddUsage[]
  treatmentLibraryItems TreatmentLibraryItem[]
  accessRequests   SafescribeAccessRequest[]
  matchedAccessRequests SafescribeAccessRequest[] @relation("AccessRequestMatchedPharmacy")

  @@index([status])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id                  String     @id @default(cuid())
  tenantId            String?
  email               String
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus @default(PENDING)
  roleId              String
  /// FULL = pharmacy + clinical; PHARMACY / CLINICAL are mutually exclusive. Null for tenant users.
  superAdminScope     SuperAdminScope?
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  /// Phix user id when this account was provisioned from Phix (per tenant).
  phixUserId          String?
  /// Pharmacist signature image stamped on Step 6 documents.
  signatureStorageKey      String?
  signatureStorageProvider String?
  signatureMimeType        String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  role            Role              @relation(fields: [roleId], references: [id])
  sessions        Session[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  loginHistory    LoginHistory[]
  passwordResets  PasswordReset[]
  loginEmailChallenges LoginEmailChallenge[]
  createdPathways ClinicalPathway[] @relation("PathwayCreatedBy")
  routingMetadataUpdates ClinicalPathway[] @relation("PathwayRoutingUpdatedBy")
  handledContactInquiries ContactInquiry[] @relation("ContactInquiryHandledBy")
  consultations   Consultation[]    @relation("ConsultationPharmacist")
  faxLogs         FaxLog[]
  allergyRuleUploads AllergyRuleDataset[] @relation("AllergyRuleUploadedBy")
  safetyRulesOwned       SafetyKnowledgeRule[] @relation("SafetyRuleOwner")
  safetyRulesApproved    SafetyRuleVersion[]   @relation("SafetyRuleApprover")
  safetyReleasesPublished SafetyKnowledgeRelease[] @relation("SafetyReleasePublisher")
  safetyEvaluationOverrides SafetyEvaluationOverride[]
  clinicalImportsUploaded ClinicalImportBatch[] @relation("ClinicalImportUploader")
  clinicalImportsImported ClinicalImportBatch[] @relation("ClinicalImportImporter")
  renewConfigReleasesPublished RenewConfigRelease[] @relation("RenewConfigPublisher")
  terminologyReleasesCreated TerminologyRelease[] @relation("TerminologyReleaseCreator")
  ipAllowlist        IpAllowlistEntry[]
  aiPromptUpdates    AiSystemPrompt[]     @relation("AiPromptUpdatedBy")
  aiSettingsUpdates  AiPlatformSettings[] @relation("AiSettingsUpdatedBy")
  docFormatUpdates   DocumentFormatTemplate[] @relation("DocFormatUpdatedBy")
  usageEvents        SafeScribeUsageEvent[]   @relation("UsageActor")
  professionalUseAcknowledgements ProfessionalUseAcknowledgement[]
  treatmentQuickAddUsages TreatmentQuickAddUsage[]
  pathwayQaWorkbooks      PathwayQaWorkbook[]      @relation("PathwayQaWorkbookUploader")
  pathwayQaRuns           PathwayQaRun[]           @relation("PathwayQaRunCreator")
  reviewedAccessRequests  SafescribeAccessRequest[] @relation("AccessRequestReviewedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, phixUserId])
  @@index([tenantId, status])
  @@index([email])
  @@index([roleId])
  @@index([phixUserId])
  @@index([superAdminScope])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  ipAddress  String?
  userAgent  String?
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

/// Email magic-link second factor after password login (Pharmacist Admin / Pharmacist).
model LoginEmailChallenge {
  id         String    @id @default(cuid())
  userId     String
  /// SHA-256 of the one-time verification token (raw token never stored).
  tokenHash  String    @unique
  rememberMe Boolean   @default(false)
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Public marketing / support inquiries from the Contact Us page (not tenant-scoped).
model ContactInquiry {
  id              String    @id @default(cuid())
  fullName        String
  workEmail       String
  organization    String
  topic           String
  message         String
  status          String    @default("new")
  internalNote    String?
  handledByUserId String?
  handledAt       DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  handledBy User? @relation("ContactInquiryHandledBy", fields: [handledByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([topic, createdAt])
  @@index([workEmail])
  @@index([status, createdAt])
  @@index([handledByUserId])
}

/// Public Alberta-launch complimentary access requests. Approval is required
/// before a pharmacy tenant, entitlement, or network allowlist is created.
model SafescribeAccessRequest {
  id                 String   @id @default(cuid())
  requestNumber      Int      @unique @default(autoincrement())
  pharmacyName       String
  licenceNumber      String
  province           String   @default("AB")
  contactName        String
  email              String
  phone              String?
  capturedPublicIp   String
  submissionPublicIp String?
  ipDiscrepancy      Boolean  @default(false)
  status             String   @default("pending")
  source             String   @default("alberta_qr_launch")
  matchType          String   @default("none")
  matchConfidence    String?
  matchReasons       Json?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  userAgent          String?
  notes              String?
  rejectReason       String?
  matchedPharmacyId  String?
  pharmacyId         String?
  submittedAt        DateTime @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pharmacy        Tenant? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  matchedPharmacy Tenant? @relation("AccessRequestMatchedPharmacy", fields: [matchedPharmacyId], references: [id], onDelete: SetNull)
  reviewedBy      User?   @relation("AccessRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([matchType, status])
  @@index([email])
  @@index([licenceNumber])
  @@index([capturedPublicIp])
  @@index([pharmacyId])
  @@index([matchedPharmacyId])
  @@index([reviewedById])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  tenantId      String?
  action        String
  module        String
  ipAddress     String?
  userAgent     String?
  deviceInfo    String?
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@index([module])
}

/// Append-only pharmacist professional-use acknowledgement audit (one row per login acknowledgement).
/// Access gating is session-scoped in Redis, not this table.
model ProfessionalUseAcknowledgement {
  id                     String   @id @default(cuid())
  userId                 String
  acknowledgementVersion String
  acknowledgedAt         DateTime @default(now())
  source                 String   @default("post_login_gate")
  copySha256             String
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, acknowledgedAt(sort: Desc)])
}

model TenantIpAccess {
  id        String       @id @default(cuid())
  tenantId  String       @unique
  enabled   Boolean      @default(false)
  mode      IpAccessMode @default(GLOBAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model IpAllowlistEntry {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String?
  cidr      String
  label     String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId])
}

model PharmacyNetwork {
  id             String                @id @default(cuid())
  tenantId       String
  ipAddress      String
  cidr           String
  label          String?
  status         PharmacyNetworkStatus @default(APPROVED)
  source         PharmacyNetworkSource @default(MANUAL)
  createdById    String?
  approvedById   String?
  verificationId String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  approvedAt     DateTime?
  lastSeenAt     DateTime?
  lastVerifiedAt DateTime?

  tenant       Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verification PharmacyNetworkVerification?   @relation(fields: [verificationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId])
}

model PharmacyNetworkVerification {
  id           String                              @id @default(cuid())
  tenantId     String
  email        String
  tokenHash    String                              @unique
  status       PharmacyNetworkVerificationStatus   @default(SENT)
  detectedIp   String?
  expiresAt    DateTime
  createdById  String
  createdAt    DateTime                            @default(now())
  updatedAt    DateTime                            @updatedAt
  openedAt     DateTime?
  confirmedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  rejectedAt   DateTime?

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  network PharmacyNetwork?

  @@index([tenantId, status])
  @@index([expiresAt])
}

/// Generic per-pharmacy module allowance (Prescribe today; Renew/Adapt/CACP later).
model SafeScribeEntitlement {
  id                String    @id @default(cuid())
  tenantId          String
  module            String
  /// Null = unlimited. Complimentary PhIX Prescribe is 10.
  includedQuantity  Int?
  period            String    @default("daily")
  active            Boolean   @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId, active])
}

/// Counted clinical assessments. One counted row per consultation (idempotent).
model SafeScribeUsageEvent {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  module          String
  consultationId  String?
  eventType       String
  counted         Boolean   @default(true)
  occurredAt      DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation("UsageActor", fields: [userId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@unique([consultationId, eventType])
  @@index([tenantId, module, counted, occurredAt])
  @@index([userId])
}

// ─── Clinical Pathway Models ───────────────────────────────────────────────────

model ClinicalPathway {
  id              String               @id @default(cuid())
  tenantId        String?
  name            String
  condition       String
  province        String
  category        String
  status          PathwayStatus        @default(DRAFT)
  /// Authoring pipeline stage (independent of publish status).
  pipelineStage   PathwayPipelineStage @default(IDLE)
  version         Int                  @default(1)
  description     String?
  notes           String?
  processingLog   Json?
  aiSummary       String?              @db.Text
  redFlags        Json?
  differentials   Json?
  /// Clinical admin signed off on generated pathway content (required before publish).
  clinicallyReviewedAt   DateTime?
  clinicallyReviewedById String?
  createdById     String
  rejectionReason String?
  publishedAt     DateTime?
  suspendedAt     DateTime?
  rejectedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // ── Pathway metadata (Overview module) ───────────────────────────────────
  /// Comma-separated province codes, e.g. "ON,BC,AB". Falls back to `province` when null.
  provinceAvailability          String?
  ageMin                        Int?
  ageMax                        Int?
  pharmacistPrescribingEligible Boolean          @default(true)
  requiresPhysicalExam          RequirementLevel @default(NEVER)
  requiresLabResults            RequirementLevel @default(NEVER)
  requiresFollowUp              Boolean          @default(false)
  guidelineSource               String?
  lastClinicalReview            DateTime?
  /// Which Assessment sections are enabled: { diagnosisConfirmation, additionalAssessment, treatmentEligibility }
  assessmentSectionsEnabled     Json?
  /// Presentation Review section-level evidence IDs (central library links only).
  presentationReview            Json?
  /// Default documentation citation for consultations (library reference ID).
  primaryDocumentationReferenceId String?
  /// Optional second documentation citation for consultations.
  secondaryDocumentationReferenceId String?
  /// Governance summary: internal/external review status + next review due.
  /// Shape: { internalReviewStatus, externalPeerReviewStatus, lastReviewedAt, nextReviewDueAt }
  governance                    Json?

  // ── Pathway Matching / Routing (Overview) ────────────────────────────────
  /// Alternative names / aliases for AI pathway suggestion (not diagnosis).
  routingAliases                String[]  @default([])
  /// Lay / symptom-first phrases pharmacists or patients may use before a pathway is selected.
  routingPresentingComplaints   String[]  @default([])
  /// Anatomical, exposure, or situational context terms that improve retrieval.
  routingContextTerms           String[]  @default([])
  /// Semantic description of presentations for which this pathway may be relevant.
  routingDescription            String?   @db.Text
  routingMetadataUpdatedAt      DateTime?
  routingMetadataUpdatedById    String?

  tenant       Tenant?               @relation(fields: [tenantId], references: [id])
  createdBy    User                  @relation("PathwayCreatedBy", fields: [createdById], references: [id])
  routingMetadataUpdatedBy User?     @relation("PathwayRoutingUpdatedBy", fields: [routingMetadataUpdatedById], references: [id])
  documents    ClinicalDocument[]
  documentOverlaps ClinicalDocumentOverlap[]
  concepts     ClinicalConcept[]
  sections     ClinicalSection[]
  questions    ClinicalQuestion[]
  rules        ClinicalRule[]
  treatments   ClinicalTreatment[]
  counsellings ClinicalCounselling[]
  followups    ClinicalFollowup[]
  versions      ClinicalVersion[]
  publications  ClinicalPublication[]
  consultations Consultation[]
  qaRuns        PathwayQaRun[]
  libraryReferences PathwayEvidenceReference[]
  evidenceMappings  PathwayEvidenceMapping[]
  reviewers         PathwayReviewer[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status])
  @@index([pipelineStage])
}

model ClinicalDocument {
  id               String    @id @default(cuid())
  pathwayId        String
  tenantId         String?
  fileName         String
  fileUrl          String
  fileSize         Int
  mimeType         String
  extractedText    String?   @db.Text
  pageCount        Int?
  processingStatus String    @default("PENDING")
  processingError  String?   @db.Text
  uploadedAt       DateTime  @default(now())
  processedAt      DateTime?

  // ── AI classification + admin role review ────────────────────────────────
  documentType         ClinicalDocumentType?
  /// AI-suggested role before admin confirmation.
  aiSuggestedRole      DocumentRole?
  /// Confirmed role used for concept extraction (REFERENCE_ONLY skipped).
  role                 DocumentRole?
  roleConfirmed        Boolean               @default(false)
  authority            String?
  publicationYear      Int?
  evidenceLevel        String?
  documentFamily       String?
  purpose              String[]              @default([])
  classificationMeta   Json?
  classificationConfidence Float?

  pathway ClinicalPathway         @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  chunks  ClinicalDocumentChunk[]
  overlapsAsSource ClinicalDocumentOverlap[] @relation("OverlapSource")
  overlapsAsTarget ClinicalDocumentOverlap[] @relation("OverlapTarget")
  conceptSources   ClinicalConceptSource[]

  @@index([pathwayId])
  @@index([tenantId])
  @@index([pathwayId, role])
}

/// Pairwise similarity / overlap between uploaded documents for a pathway.
model ClinicalDocumentOverlap {
  id               String   @id @default(cuid())
  pathwayId        String
  sourceDocumentId String
  targetDocumentId String
  overlapPercent   Float
  /// AI-recommended role for the *target* document relative to source.
  recommendedRole  DocumentRole
  rationale        String   @db.Text
  createdAt        DateTime @default(now())

  pathway        ClinicalPathway  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  sourceDocument ClinicalDocument @relation("OverlapSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocument ClinicalDocument @relation("OverlapTarget", fields: [targetDocumentId], references: [id], onDelete: Cascade)

  @@unique([pathwayId, sourceDocumentId, targetDocumentId])
  @@index([pathwayId])
}

/// Normalized clinical concepts extracted from documents — persisted for regeneration without re-reading PDFs.
model ClinicalConcept {
  id              String                  @id @default(cuid())
  pathwayId       String
  tenantId        String?
  category        ClinicalConceptCategory
  /// Canonical normalized label (post-dedup).
  label           String
  description     String?                 @db.Text
  /// Structured extras: dose, severity, action, etc.
  metadata        Json?
  importance      String?                 /// HIGH | MEDIUM | LOW
  confidence      Float?
  /// Raw phrases merged into this concept.
  aliases         String[]                @default([])
  isAiGenerated   Boolean                 @default(true)
  approved        Boolean                 @default(false)
  displayOrder    Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  pathway ClinicalPathway         @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  sources ClinicalConceptSource[]

  @@index([pathwayId, category])
  @@index([pathwayId, displayOrder])
  @@index([tenantId])
}

model ClinicalConceptSource {
  id              String   @id @default(cuid())
  conceptId       String
  documentId      String
  sourceExcerpt   String?  @db.Text
  sourcePage      Int?
  createdAt       DateTime @default(now())

  concept  ClinicalConcept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  document ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([conceptId, documentId])
  @@index([documentId])
}

model ClinicalDocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String   @db.Text
  pageNumber Int?
  section    String?
  tokenCount Int?
  createdAt  DateTime @default(now())

  document ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
}

model ClinicalSection {
  id            String   @id @default(cuid())
  pathwayId     String
  name          String
  displayName   String
  description   String?
  displayOrder  Int      @default(0)
  isAiGenerated Boolean  @default(true)
  /// Conditional visibility, e.g. { "all": [{ "field": "demographics.sex", "operator": "eq", "value": "Male" }] }
  visibility    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pathway   ClinicalPathway    @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  questions ClinicalQuestion[]

  @@index([pathwayId, displayOrder])
}

model ClinicalQuestion {
  id              String           @id @default(cuid())
  pathwayId       String
  sectionId       String?
  tenantId        String?
  question        String
  description     String?
  helpText        String?
  type            QuestionType
  required        Boolean          @default(true)
  displayOrder    Int              @default(0)
  options         Json?
  validation      Json?
  sourceDocument  String?
  sourcePage      Int?
  sourceReference String?
  /// Linked IDs from PathwayEvidenceReference (References & Governance library).
  evidenceRefIds  String[]         @default([])
  /// Optional conditional visibility, e.g. { sourceField, operator, value, label }.
  visibilityRule  Json?
  confidence      Float?
  status          QuestionStatus   @default(AI_GENERATED)
  createdBy       ContentCreatedBy @default(AI)
  approved        Boolean          @default(false)
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  pathway ClinicalPathway  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  section ClinicalSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  rules   ClinicalRule[]

  @@index([pathwayId, sectionId, displayOrder])
  @@index([pathwayId, status])
  @@index([tenantId])
}

/// Platform-wide citation master (Super Admin). Pathways attach copies via libraryItemId.
model EvidenceReferenceLibraryItem {
  id                      String    @id @default(cuid())
  citationTitle           String
  organization            String?
  edition                 String?
  publicationYear         Int?
  url                     String?
  doi                     String?
  documentType            String?
  jurisdiction            String?
  referenceType           String    @default("source")
  /// verified | needs_review | verification_required | archived
  status                  String    @default("needs_review")
  verifiedBy              String?
  verificationDate        DateTime?
  importSource            String    @default("manual")
  isRetired               Boolean   @default(false)
  /// Controlled clinical-use tag codes (see CLINICAL_USE_TAG_CODES).
  clinicalUseTags         String[]  @default([])
  /// Suggested Prescribe sections (presentation_review, …, section_wide).
  suggestedSections       String[]  @default([])
  documentationCandidate  Boolean   @default(false)
  verificationRequired    Boolean   @default(false)
  notes                   String?   @db.VarChar(500)
  searchText              String    @default("") @db.Text
  stableKey               String    @unique
  pathwayUsageCount       Int       @default(0)
  createdById             String
  updatedById             String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  pathwayLinks PathwayEvidenceReference[]

  @@index([isRetired, status, updatedAt])
  @@index([documentType])
  @@index([updatedAt])
}

/// Platform-wide reviewer master (Super Admin). Pathways attach copies via libraryReviewerId.
model ReviewerLibraryItem {
  id                String   @id @default(cuid())
  /// Preferred type when linking: internal | external
  reviewerType      String
  name              String
  credentials       String
  organization      String?
  role              String
  isRetired         Boolean  @default(false)
  searchText        String   @default("") @db.Text
  stableKey         String   @unique
  pathwayUsageCount Int      @default(0)
  createdById       String
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pathwayLinks PathwayReviewer[]

  @@index([isRetired, reviewerType, updatedAt])
  @@index([updatedAt])
}

/// Pathway-scoped citation library. Content modules store IDs / mappings only.
model PathwayEvidenceReference {
  id                     String    @id @default(cuid())
  pathwayId              String
  tenantId               String?
  libraryItemId          String?
  citationTitle          String
  organization           String?
  edition                String?
  publicationYear        Int?
  url                    String?
  doi                    String?
  documentType           String?
  jurisdiction           String?
  referenceType          String    @default("source")
  /// verified | needs_review | verification_required | archived
  status                 String    @default("needs_review")
  verifiedBy             String?
  verificationDate       DateTime?
  /// manual | chatgpt | excel | migration | library
  importSource           String    @default("manual")
  clinicalUseTags        String[]  @default([])
  documentationCandidate Boolean   @default(false)
  verificationRequired   Boolean   @default(false)
  notes                  String?   @db.VarChar(500)
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  pathway     ClinicalPathway                @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  libraryItem EvidenceReferenceLibraryItem?  @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)
  mappings    PathwayEvidenceMapping[]

  @@index([pathwayId, createdAt])
  @@index([pathwayId, status])
  @@index([tenantId])
  @@index([libraryItemId])
}

/// Central evidence link from a library reference to pathway content.
model PathwayEvidenceMapping {
  id          String   @id @default(cuid())
  pathwayId   String
  referenceId String
  /// presentation_review | differential_review | red_flags | treatment_options | patient_guidance
  section     String
  /// section | question | differential | red_flag | treatment | guidance
  mappingType String
  /// Empty string = section-wide / no specific target (keeps unique constraint reliable).
  targetId    String   @default("")
  /// ChatGPT-suggested mapping not yet confirmed by admin
  suggested   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pathway   ClinicalPathway          @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  reference PathwayEvidenceReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([pathwayId, referenceId, section, mappingType, targetId])
  @@index([pathwayId, referenceId])
  @@index([pathwayId, section])
  @@index([referenceId])
}

/// Internal or independent external pathway reviewers (References & Governance).
model PathwayReviewer {
  id                String   @id @default(cuid())
  pathwayId         String
  libraryReviewerId String?
  /// internal | external
  reviewerType      String
  name              String
  credentials       String
  organization      String?
  role              String
  reviewedAreas     String[]
  reviewDate        DateTime
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pathway         ClinicalPathway       @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  libraryReviewer ReviewerLibraryItem?  @relation(fields: [libraryReviewerId], references: [id], onDelete: SetNull)

  @@index([pathwayId, reviewerType])
  @@index([libraryReviewerId])
}

model ClinicalRule {
  id            String       @id @default(cuid())
  pathwayId     String
  questionId    String?
  tenantId      String?
  condition     String
  operator      String
  value         String
  action        RuleAction
  severity      RuleSeverity @default(WARNING)
  message       String
  details       String?
