  approved      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  pathway  ClinicalPathway   @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  question ClinicalQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([pathwayId])
  @@index([questionId])
  @@index([tenantId])
}

model ClinicalTreatment {
  id                   String              @id @default(cuid())
  pathwayId            String
  tenantId             String?
  category             TreatmentCategory   @default(PRESCRIPTION)
  recommendationLevel  RecommendationLevel @default(FIRST_LINE)
  /// Display name: medication / product / supplement / non-drug recommendation
  medicationName       String
  genericName          String?
  brandName            String?
  strength             String?
  dose                 String?
  route                String?
  frequency            String?
  duration             String?
  quantity             String?
  directions           String?             @db.Text
  maxDose              String?
  eligibility          String?             @db.Text
  clinicalIndication   String?             @db.Text
  clinicalNotes        String?             @db.Text
  guidelineReference   String?
  /// Linked IDs from PathwayEvidenceReference (central library).
  evidenceRefIds       String[]            @default([])
  /// Optional treatment-level documentation citation override (library reference ID).
  documentationReferenceId String?
  evidenceStrength     String?
  renalAdjustment      String?
  hepaticAdjustment    String?
  pregnancyNotes       String?
  breastfeedingNotes   String?
  /// Why the corresponding Yes flag applies — shown in consultation warnings
  pregnancyReason      String?             @db.Text
  renalAdjustmentReason String?            @db.Text
  /// Authoritative source measure: CrCl | eGFR | OTHER | NONE
  renalSourceBasis      String?
  /// CrCl | eGFR | NONE — operational match; prefer eGFR for new imports
  renalDosingBasis      String?
  /// Structured RenalDosingRule[] used for deterministic pharmacist matching
  renalDosingRules      Json?
  hepaticAdjustmentReason String?          @db.Text
  monitoringReason     String?             @db.Text
  counsellingNotes     String?             @db.Text
  followUpAdvice       String?             @db.Text
  ageRestriction       String?
  /// Comma-separated province codes, e.g. "MB,ON,BC" or "ALL"
  provinceAvailability String?
  warnings             String[]
  interactions         String[]
  monitoring           String?
  isAiGenerated        Boolean             @default(true)
  approved             Boolean             @default(false)
  /// Soft-disable without deleting (province/off-formulary / temporary)
  isActive             Boolean             @default(true)
  archivedAt           DateTime?
  /// Future-proof bag: formulary, authority rules, shortage substitutes, cost, etc.
  metadata             Json?
  displayOrder         Int                 @default(0)
  treatmentLibraryItemId     String?
  treatmentLibraryVersionId  String?
  sourceVersionNumber        Int?
  sourcePayloadHash          String?
  sourceSnapshot             Json?
  pathwayOverrides           Json?
  libraryLinkStatus          TreatmentLibraryLinkStatus @default(MANUAL)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  pathway ClinicalPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  treatmentLibraryItem    TreatmentLibraryItem?    @relation(fields: [treatmentLibraryItemId], references: [id], onDelete: SetNull)
  treatmentLibraryVersion TreatmentLibraryVersion? @relation(fields: [treatmentLibraryVersionId], references: [id], onDelete: SetNull)

  @@index([pathwayId])
  @@index([pathwayId, category, displayOrder])
  @@index([pathwayId, isActive])
  @@index([tenantId])
  @@index([treatmentLibraryItemId])
  @@index([treatmentLibraryVersionId])
}

/// Curated reusable regimen. List/search columns are denormalized from the
/// working version so admin queries stay indexed and do not scan JSONB.
model TreatmentLibraryItem {
  id                       String                       @id @default(cuid())
  tenantId                 String?
  stableKey                String                       @unique
  currentApprovedVersionId String?
  isRetired                Boolean                      @default(false)
  displayName              String
  genericName              String                       @default("")
  brandName                String                       @default("")
  strength                 String                       @default("")
  productFormDisplay       String                       @default("")
  routeDisplay             String                       @default("")
  regimenLabel             String                       @default("")
  category                 String                       @default("PRESCRIPTION")
  population               TreatmentLibraryPopulation   @default(ADULT)
  matchStatus              TreatmentLibraryMatchStatus  @default(UNMATCHED)
  listStatus               TreatmentLibraryVersionStatus @default(DRAFT)
  approvedVersionNumber    Int?
  searchText               String                       @default("") @db.Text
  identifierText           String                       @default("")
  pathwayUsageCount        Int                          @default(0)
  createdById              String
  updatedById              String
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

