# Zone-scoped token for safescribe.ca only. Do not commit the real token.
# Create: https://dash.cloudflare.com/profile/api-tokens
# Template: Edit zone DNS
# Extra permissions: Zone Settings Edit, SSL and Certificates Edit
# Zone Resources: Include → safescribe.ca
#
# CLOUDFLARE_API_TOKEN=... ./infra/production/scripts/cloudflare-dns-setup.sh
CLOUDFLARE_API_TOKEN=
