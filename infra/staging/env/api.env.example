# Copy values from secrets manager / bootstrap — never commit real secrets.
NODE_ENV=production
DATABASE_URL=postgresql://safescribe:CHANGE_ME@127.0.0.1:5432/safescribe?schema=public
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS________________
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS________________
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SUPER_ADMIN_EMAIL=admin@safescribe.ca
SUPER_ADMIN_PASSWORD=CHANGE_ME_Strong1!
API_PORT=3001
API_URL=https://api-staging.safescribe.ca
NEXT_PUBLIC_API_URL=https://api-staging.safescribe.ca
WEB_URL=https://staging.safescribe.ca
CORS_ORIGINS=https://staging.safescribe.ca,https://safescribe.ca,https://www.safescribe.ca,https://app.safescribe.ca
AI_ENGINE_URL=http://127.0.0.1:8000
# Short AI calls (classify / consult). Pathway extract/generate use LONG timeout.
AI_ENGINE_TIMEOUT_MS=300000
AI_ENGINE_LONG_TIMEOUT_MS=900000
# Must match INTERNAL_SECRET in /etc/safescribe/ai.env (live AI prompt sync)
AI_ENGINE_INTERNAL_SECRET=CHANGE_ME_MIN_32_CHARS________________
INTERNAL_SECRET=CHANGE_ME_MIN_32_CHARS________________
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FAST_MODEL=gpt-5.6-luna
# Speech-to-Text (Step 1 live dictation)
STT_DEFAULT_PROVIDER=whisper
STT_WHISPER_ENABLED=true
# OpenAI: whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
# Large v3 via Groq: whisper-large-v3 | whisper-large-v3-turbo (requires STT_GROQ_API_KEY)
STT_WHISPER_MODEL=whisper-1
STT_GROQ_API_KEY=

STT_GOOGLE_ENABLED=true
STT_GOOGLE_MODEL=medical_dictation
STT_GOOGLE_LANGUAGE=en-US
UPLOAD_DIR=/opt/safescribe/apps/api/uploads
UPLOAD_MAX_SIZE_MB=20

# GCP Cloud Storage for consultation clinical photos (private bucket)
GCS_PROJECT_ID=safescribe-488815
GCS_BUCKET=safescribe-consult-attachments
GOOGLE_APPLICATION_CREDENTIALS=/etc/safescribe/gcs-sa.json
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# API rate limits (NestJS throttler). Consultation / terminology routes are exempt.
THROTTLE_SHORT_TTL_MS=1000
THROTTLE_SHORT_LIMIT=25
THROTTLE_MEDIUM_TTL_MS=10000
THROTTLE_MEDIUM_LIMIT=150
THROTTLE_LONG_TTL_MS=60000
THROTTLE_LONG_LIMIT=500
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@safescribe.ca
CONTACT_TO_EMAIL=support@pharmasafe.ca

# Resend transactional email
# Resend transactional email — API lives on GCP, not Vercel.
RESEND_ENABLED=true
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL="Safescript <noreply@phix.now>"
RESEND_WEBHOOK_SECRET=whsec_CHANGE_ME
EMAIL_APP_URL=https://staging.safescribe.ca

# Email magic-link second factor after password (Pharmacist Admin + Pharmacist). Super Admin skipped.
# Off so login is email + password. Set true to require the verify-email step.
LOGIN_EMAIL_2FA_ENABLED=false
LOGIN_EMAIL_2FA_TTL_MINUTES=15
# Demo / walkthrough accounts skip email 2FA after a valid password. Set to none to disable.
DEMO_LOGIN_BYPASS_EMAILS=

# Canadian CCDD drug search (Infoway Terminology Server OAuth)
# Request credentials: https://infocentral.infoway-inforoute.ca/en/advanced-users
# These belong on the Nest API VM only — do NOT put them on Vercel (frontend).
DRUG_SEARCH_PROVIDER=ccdd
INFOWAY_CLIENT_ID=CHANGE_ME
INFOWAY_CLIENT_SECRET=CHANGE_ME

# Optional — raises OpenFDA drug-label rate limits (Treatment Safety panel)
OPENFDA_API_KEY=

# iFax — outbound consultation document fax (no cover page)
IFAX_API_KEY=
IFAX_BASE_URL=https://api.ifaxapp.com/v1
IFAX_CALLER_ID=
IFAX_WEBHOOK_SECRET=
IFAX_ENABLED=true
IFAX_FAX_QUALITY=HD

# ── SafeScribe Mic (phone-as-microphone companion) ───────────────────────────
SAFESCRIBE_MIC_ENABLED=true
SAFESCRIBE_RENEW_ENABLED=true
SAFESCRIBE_ADAPT_ENABLED=true
SAFESCRIBE_MIC_PILOT_TENANT_IDS=
MIC_PAIRING_TTL_SECONDS=300
MIC_SESSION_MAX_SECONDS=5400
MIC_HEARTBEAT_INTERVAL_SECONDS=15
MIC_MAX_UPLOAD_BYTES=262144000
MIC_AUDIO_RETENTION_MODE=DELETE_AFTER_SUCCESS
MIC_AUDIO_DELETE_GRACE_SECONDS=3600
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=whisper-1

# Patient Care Summary translation (reuses GCS service account)
GOOGLE_CLOUD_PROJECT=safescribe-488815
GOOGLE_TRANSLATE_LOCATION=global
GOOGLE_TRANSLATE_MODEL=general/nmt
TRANSLATION_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=604800
GOOGLE_TRANSLATE_TIMEOUT_MS=15000

# Phix → SafeScribe sync (HMAC + API key). Leave empty to disable the endpoint.
PHIX_SYNC_API_KEY=CHANGE_ME_MIN_24_CHARS________
PHIX_SYNC_HMAC_SECRET=CHANGE_ME_MIN_32_CHARS________________

